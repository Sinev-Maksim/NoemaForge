{
  "apiVersion": "noemaforge.pipeline-dragdrop-editor/v1",
  "kind": "PipelineDragDropEditorExample",
  "editor_mode": "drag_drop_pipeline_editor",
  "input": {
    "id": "demo_pipeline",
    "title": "Demo pipeline",
    "stages": ["intake", "plan", "review"]
  },
  "drag_drop_result": {
    "stages": ["plan", "intake", "review"]
  },
  "expected_result": {
    "activation_state": "draft_only",
    "review_required": true,
    "draft_endpoint": "/api/pipelines/draft"
  }
}
