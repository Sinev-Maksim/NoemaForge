            "provenance": "example",
            "sha256": "2222222222222222222222222222222222222222222222222222222222222222",
            "maintainer": "example",
            "review_policy": "admin-required"
          }
        },
        {
          "id": "license-missing-artifact",
          "activation_state": "quarantined",
          "claim": "skip quarantine for community pack",
          "manifest": {
            "pack_id": "license-missing-artifact",
            "pack_kind": "ArtifactPack",
            "version": "0.1.0",
            "provenance": "example",
            "sha256": "3333333333333333333333333333333333333333333333333333333333333333",
            "maintainer": "example",
            "review_policy": "admin-required"
          }
        },
        {
          "id": "public-modeldelta",
          "activation_state": "promoted",
          "claim": "promote ModelDeltaPack into public core",
          "manifest": {
            "pack_id": "public-modeldelta",
            "pack_kind": "ModelDeltaPack",
            "version": "0.1.0",
            "license": "Apache-2.0",
            "provenance": "example",
            "sha256": "4444444444444444444444444444444444444444444444444444444444444444",
            "maintainer": "example",
            "review_policy": "lab-only"
          }
