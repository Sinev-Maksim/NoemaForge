{
  "apiVersion": "noemaforge.community-pack-contribution/v1",
  "kind": "CommunityPackContributionExampleSet",
  "id": "community-pack-contribution-examples",
  "version": "0.31.21.alpha",
  "scenarios": [
    {
      "id": "quarantine-first-community-evalpack",
      "trace_id": "trace:community-pack-contribution:example:001",
      "accepted_pack": {
        "activation_state": "quarantined",
        "manifest": {
          "pack_id": "community-smoke-evals",
          "pack_kind": "EvalPack",
          "version": "0.1.0",
