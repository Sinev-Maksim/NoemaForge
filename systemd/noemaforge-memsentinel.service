[Unit]
Description=NoemaForge Memory Sentinel
After=network.target
ConditionPathExists=/opt/noemaforge/src/memsentinel.py

[Service]
Type=simple
User=noemaforge
Group=noemaforge
Environment=NOEMAFORGE_ROOT=/opt/noemaforge
Environment=NOEMAFORGE_STATE=/var/lib/noemaforge
EnvironmentFile=-/etc/default/noemaforge-runtime
ExecStart=/usr/bin/python3 /opt/noemaforge/src/memsentinel.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
