# === NoemaForge File Header ===
# File: systemd/noemaforge-modelscan.service
# Zone: release/package
# Version: 0.32.2
# Created: 2026-06-08
# Modified: 2026-06-08
# Purpose: Periodically rebuild the ModelStore registry (model_registry.json). Triggered by
#   noemaforge-modelscan.timer. Mirrors brainctl.provision_modelscan() so the base install ships
#   the same unit the manager would otherwise provision on enable.
# Inputs: package files and NoemaForge runtime state under /var/lib/noemaforge, /var/lib/modelstore.
# Outputs: refreshed model_registry.json.
# Side effects: writes only ReadWritePaths; no network, no privilege escalation.
# Tests: Syntax validation plus the release setup selftest, consistency-audit and targeted smoke checks.
# Notes: Code comments are English-only; user-facing localized text belongs in docs/i18n or locale JSON files.
# === End NoemaForge File Header ===
[Unit]
Description=NoemaForge ModelStore Registry Scan
After=local-fs.target
ConditionPathExists=/var/lib/noemaforge/.sys/setup.done

[Service]
Type=oneshot
User=noemaforge
Group=noemaforge
Slice=noemaforge-core.slice
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/noemaforge /var/lib/modelstore
ExecStart=/usr/bin/python3 /opt/noemaforge/src/model_registry.py --write
