# === NoemaForge File Header ===
# File: systemd/noemaforge-llm-backends-manager.service
# Zone: release/package
# Version: 0.32.2
# Created: 2026-06-08
# Modified: 2026-06-08
# Purpose: Report the single-active-model llama backend reconcile PLAN (drift only). The
#   timer-triggered path runs --plan and is DISPLAY-SAFE: it starts NO heavy/GPU backend.
#   Applying the plan (which may start noemaforge-llama@*.service / GPU work) is operator-gated
#   via `noemaforge manager reconcile` — heavy_llm_autostart=manual_only, run with --keep-display.
# Inputs: llm-backends-policy.yaml; runtime state under /var/lib/noemaforge.
# Outputs: YAML start/stop plan to the journal (no changes applied).
# Side effects: none (plan-only); makes no systemctl service changes.
# Tests: Syntax validation plus the release setup selftest, consistency-audit and targeted smoke checks.
# Notes: Code comments are English-only; user-facing localized text belongs in docs/i18n or locale JSON files.
# === End NoemaForge File Header ===
[Unit]
Description=NoemaForge LLM Backends Manager (plan-only drift report; apply is operator-gated)
After=local-fs.target noemaforge-llm-gateway.service
ConditionPathExists=/var/lib/noemaforge/.sys/setup.done

[Service]
Type=oneshot
User=noemaforge
Group=noemaforge
Slice=noemaforge-core.slice
Environment=NOEMAFORGE_ROOT=/opt/noemaforge
Environment=NOEMAFORGE_STATE=/var/lib/noemaforge
# --plan: print the reconcile plan WITHOUT starting/stopping backends (display-safe; manual_only).
ExecStart=/usr/bin/python3 /opt/noemaforge/src/llm_backends_manager.py --plan
