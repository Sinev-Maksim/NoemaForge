[Unit]
Description=NoemaForge conditional safe autostart in woGUI/headless mode
Documentation=file:/usr/local/share/noemaforge/docs/AUTOSTART_BOOT_MODES_0.30.20.md
Wants=network-online.target
After=multi-user.target network-online.target local-fs.target
ConditionPathExists=/etc/noemaforge/boot-mode

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/noemaforge-runtime
EnvironmentFile=-/etc/default/noemaforge-firstboot
ExecStart=/opt/noemaforge/tools/prep/noemaforge-autostart-safe.sh --mode wogui
TimeoutStartSec=20min
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
