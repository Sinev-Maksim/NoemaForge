# NoemaForge runtime host-local configuration.
# Copy to /etc/default/noemaforge-runtime and adjust for your host.
# This file contains only non-secret local defaults.

NOEMAFORGE_ROOT="/opt/noemaforge"
NOEMAFORGE_STATE="/var/lib/noemaforge"
NOEMAFORGE_MODELSTORE_ROOT="/var/lib/modelstore"

NOEMAFORGE_GATEWAY_SOCKET="/run/noemaforge/llm/gateway.sock"
NOEMAFORGE_TOOLPROXY_SOCKET="/run/noemaforge/toolproxy.sock"
NOEMAFORGE_BACKENDS="main:/run/noemaforge/llm/backends/main.sock"
NOEMAFORGE_DEFAULT_MODEL="main"

NOEMAFORGE_MAX_ACTIVE_LLMS="1"
NOEMAFORGE_HEAVY_LLM_AUTOSTART="manual_only"
NOEMAFORGE_MAX_BODY_BYTES="10485760"
NOEMAFORGE_LLAMA_SERVER="/opt/noemaforge/bin/llama-server"
