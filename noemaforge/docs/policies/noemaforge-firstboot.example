# NoemaForge firstboot host-local configuration.
# Copy to /etc/default/noemaforge-firstboot and adjust for your host.
# This file contains only non-secret local defaults.

NOEMAFORGE_SHARE_ROOT="/mnt/noemaforge-share"
NOEMAFORGE_VAULT_ROOT="/mnt/noemaforge-share/noemaforge-lab/data/Vault"
NOEMAFORGE_MODEL_PROFILE="minimal"
NOEMAFORGE_FIRSTBOOT_STATE="/var/lib/noemaforge/bootstrap"
NOEMAFORGE_ROLE_EVAL_DATASET="/opt/noemaforge/datasets/role_eval_cases"

NOEMAFORGE_TOURNAMENT_PER_MODEL_TIMEOUT="180"
NOEMAFORGE_TOURNAMENT_TOTAL_TIMEOUT="1800"
NOEMAFORGE_KEEP_DISPLAY="1"
NOEMAFORGE_ALLOW_DISPLAY_STOP="0"
