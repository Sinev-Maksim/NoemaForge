{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/evolution_work_item.schema.json",
  "title": "NoemaForge Evolution Work Item",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "work_item_id",
    "run_id",
    "title",
    "status",
    "risk_class",
    "task_scope",
    "required_skills",
    "dependencies",
    "attempt_budget",
    "semantic_attempts_used",
    "provider_attempts_used"
  ],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.evolution.work-item/v1"
    },
    "kind": {
      "const": "EvolutionWorkItem"
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "status": {
      "enum": [
        "planned",
        "awaiting_approval",
        "ready",
        "running",
        "blocked",
        "paused",
        "completed",
        "failed",
        "cancelled",
        "quarantined"
      ]
    },
    "risk_class": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "task_scope": {
      "type": "object",
      "required": [
        "repository",
        "allowed_paths"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "base_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "network_allowed": {
          "type": "boolean"
        },
        "privileged_actions_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "assigned_persona": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "attempt_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "semantic_attempts_used": {
      "type": "integer",
      "minimum": 0
    },
    "provider_attempts_used": {
      "type": "integer",
      "minimum": 0
    },
    "exact_head": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "blocker_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
