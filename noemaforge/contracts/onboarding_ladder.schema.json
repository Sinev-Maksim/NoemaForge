{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.local/contracts/onboarding_ladder.schema.json",
  "title": "NoemaForge Onboarding Ladder Policy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {"const": "noemaforge.onboarding-ladder/v1"},
    "kind": {"const": "OnboardingLadderPolicy"},
    "id": {"const": "onboarding-ladder-core"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "shadow", "stable", "retired"]},
    "policy": {
      "type": "object",
      "required": ["mode", "activation_state", "required_pipeline_ref", "boundary_phrase", "required_order", "required_boundary_refs", "primary_docs", "forbidden_primary_leads", "required_example_sets"],
      "properties": {
        "mode": {"const": "offline_contract"},
        "activation_state": {"const": "primary_docs_ladder"},
        "required_pipeline_ref": {"type": "string", "pattern": "^pipeline:"},
        "require_registry_attachment": {"const": true},
        "require_docs_and_changelog_refs": {"const": true},
        "require_no_live_dependency": {"const": true},
        "boundary_phrase": {"type": "string", "minLength": 80},
        "required_order": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "required_boundary_refs": {"type": "array", "minItems": 8, "items": {"type": "string"}},
        "primary_docs": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "forbidden_primary_leads": {"type": "array", "items": {"type": "string"}},
        "required_example_sets": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "refs": {"type": "array", "minItems": 14, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
