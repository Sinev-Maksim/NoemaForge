{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/a2a_interop_registry.schema.json",
  "title": "A2AInteropRegistry",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "policy", "peers"],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.a2a-interop/v1"
    },
    "kind": {
      "const": "A2AInteropRegistry"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,119}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "required": [
        "default_state",
        "default_direction",
        "default_network",
        "require_trace_id",
        "require_capability_token",
        "require_registry_entry",
        "require_operator_review",
        "require_release_evidence_before_enable",
        "allowed_transports",
        "blocked_transports",
        "allowed_payload_classes",
        "max_peer_risk"
      ],
      "properties": {
        "default_state": {
          "const": "disabled"
        },
        "default_direction": {
          "const": "none"
        },
        "default_network": {
          "const": "deny"
        },
        "require_trace_id": {
          "const": true
        },
        "require_capability_token": {
          "const": true
        },
        "require_registry_entry": {
          "const": true
        },
        "require_operator_review": {
          "const": true
        },
        "require_release_evidence_before_enable": {
          "const": true
        },
        "allowed_transports": {
          "type": "array",
          "items": {
            "enum": ["offline_manifest", "local_loopback", "http", "grpc", "websocket", "tcp"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "blocked_transports": {
          "type": "array",
          "items": {
            "enum": ["offline_manifest", "local_loopback", "http", "grpc", "websocket", "tcp"]
          },
          "uniqueItems": true
        },
        "allowed_payload_classes": {
          "type": "array",
          "items": {
            "enum": ["capability_manifest", "task_summary", "review_request", "release_evidence"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "max_peer_risk": {
          "enum": ["low", "medium", "high", "critical"]
        }
      },
      "additionalProperties": false
    },
    "peers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "protocol",
          "state",
          "transport",
          "direction",
          "network",
          "risk",
          "autonomy_increase",
          "capability_scopes",
          "allowed_payload_classes",
          "allowed_actions",
          "trace_required",
          "capability_token_required",
          "registry_entry_required",
          "registry_ref",
          "audit_logging",
          "human_review_required",
          "sandbox",
          "review",
          "release_evidence",
          "rollback_plan",
          "refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.:-]{0,119}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "protocol": {
            "const": "a2a"
          },
          "state": {
            "enum": ["disabled", "shadow", "canary", "enabled", "retired"]
          },
          "transport": {
            "enum": ["offline_manifest", "local_loopback", "http", "grpc", "websocket", "tcp"]
          },
          "direction": {
            "enum": ["none", "inbound", "outbound", "bidirectional"]
          },
          "network": {
            "const": "deny"
          },
          "risk": {
            "enum": ["low", "medium", "high", "critical"]
          },
          "autonomy_increase": {
            "const": false
          },
          "capability_scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:-]{0,80}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "allowed_payload_classes": {
            "type": "array",
            "items": {
              "enum": ["capability_manifest", "task_summary", "review_request", "release_evidence"]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "allowed_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:-]{0,80}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "trace_required": {
            "const": true
          },
          "capability_token_required": {
            "const": true
          },
          "registry_entry_required": {
            "const": true
          },
          "registry_ref": {
            "type": "string",
            "pattern": "^[a-z-]+:[A-Za-z0-9_.:-]+:[A-Za-z0-9_.:-]+$"
          },
          "audit_logging": {
            "const": true
          },
          "human_review_required": {
            "const": true
          },
          "sandbox": {
            "type": "object",
            "required": ["profile", "write", "egress", "external_identity"],
            "properties": {
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "write": {
                "const": false
              },
              "egress": {
                "const": "deny"
              },
              "external_identity": {
                "const": "none"
              }
            },
            "additionalProperties": false
          },
          "review": {
            "type": "object",
            "required": ["required", "route", "reviewers"],
            "properties": {
              "required": {
                "const": true
              },
              "route": {
                "type": "string",
                "minLength": 1
              },
              "reviewers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "evidence_ref": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "release_evidence": {
            "type": "object",
            "required": ["required_before_enable", "evidence_ref"],
            "properties": {
              "required_before_enable": {
                "const": true
              },
              "evidence_ref": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "rollback_plan": {
            "type": "string",
            "minLength": 20
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
