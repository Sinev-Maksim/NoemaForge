{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/task_run.schema.json",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "ts_start",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "ts_start": {
      "type": "string"
    },
    "ts_end": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED",
        "DEFERRED",
        "SKIPPED"
      ]
    },
    "artifacts": {
      "type": "array"
    }
  },
  "additionalProperties": true
}