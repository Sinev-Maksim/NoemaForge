{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/supplychain_policy.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "enabled", "tool_vault", "enforcement"],
  "properties": {
    "apiVersion": {"type": "string"},
    "kind": {"type": "string", "enum": ["SupplyChainPolicy"]},
    "enabled": {"type": "boolean"},
    "tool_vault": {
      "type": "object",
      "required": ["root", "manifests_dir", "artifacts_dir"],
      "properties": {
        "root": {"type": "string"},
        "manifests_dir": {"type": "string"},
        "artifacts_dir": {"type": "string"}
      },
      "additionalProperties": true
    },
    "enforcement": {
      "type": "object",
      "properties": {
        "require_attestation_for_enabled_risks": {"type": "array", "items": {"type": "string"}},
        "require_attestation_for_handlers": {"type": "array", "items": {"type": "string"}},
        "fail_in_full_suite": {"type": "boolean"},
        "warn_in_smoke_suite": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "attestation": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
