{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/evolution_run.schema.json",
  "title": "NoemaForge Evolution Run",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "run_id",
    "project_id",
    "mission",
    "status",
    "created_at",
    "updated_at",
    "source_adapter",
    "policy_epoch",
    "approval_state",
    "provenance"
  ],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.evolution.run/v1"
    },
    "kind": {
      "const": "EvolutionRun"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "mission": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "status": {
      "enum": [
        "planned",
        "awaiting_approval",
        "ready",
        "running",
        "blocked",
        "paused",
        "completed",
        "failed",
        "cancelled",
        "quarantined"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_adapter": {
      "type": "string",
      "minLength": 1
    },
    "policy_epoch": {
      "type": "string",
      "minLength": 1
    },
    "exact_base_head": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "current_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_item_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approval_state": {
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected",
        "expired"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "classification",
        "reference_material"
      ],
      "properties": {
        "classification": {
          "const": "UAT request findings resolution"
        },
        "reference_material": {
          "enum": [
            "none",
            "local-only"
          ]
        },
        "external_source_code_imported": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
