{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/llm_backends_policy.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "backends"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "noemaforge.llmbackends/v1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "LLMBackendsPolicy"
      ]
    },
    "defaults": {
      "type": "object",
      "properties": {
        "min_enabled": {
          "type": "integer",
          "minimum": 0
        },
        "enforce_main_present": {
          "type": "boolean"
        },
        "max_enabled": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "enabled",
          "model_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,80}$"
          },
          "enabled": {
            "type": "boolean"
          },
          "model_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,80}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "cpu",
              "hybrid",
              "gpu"
            ],
            "default": "cpu"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}