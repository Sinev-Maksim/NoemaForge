{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.local/contracts/graph_gap_notice.schema.json",
  "title": "NoemaForge Graph Gap Notice Policy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "refs", "policy"],
  "properties": {
    "apiVersion": {"const": "noemaforge.graph-gap-notice/v1"},
    "kind": {"const": "GraphGapNoticePolicy"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,220}$"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "shadow", "stable", "retired"]},
    "refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "required_pipeline_ref",
        "boundary_phrase",
        "grounded_administrator_policy_ref",
        "hypergraph_first_policy_ref",
        "knowledge_manifest_ref",
        "grounded_answer_runtime_ref",
        "required_algorithms",
        "gap_order",
        "required_gap_followups",
        "required_static_tokens",
        "controls",
        "required_outputs",
        "blocked_answer_claims",
        "required_boundary_refs",
        "scan_refs",
        "required_example_sets"
      ],
      "properties": {
        "mode": {"const": "offline_contract"},
        "activation_state": {"const": "explicit_graph_miss_notice"},
        "required_pipeline_ref": {"type": "string", "pattern": "^pipeline:"},
        "require_trace_id": {"const": true},
        "require_registry_attachment": {"const": true},
        "require_docs_and_changelog_refs": {"const": true},
        "require_no_live_dependency": {"const": true},
        "boundary_phrase": {"type": "string", "minLength": 1},
        "grounded_administrator_policy_ref": {"type": "string", "minLength": 1},
        "hypergraph_first_policy_ref": {"type": "string", "minLength": 1},
        "knowledge_manifest_ref": {"type": "string", "minLength": 1},
        "grounded_answer_runtime_ref": {"type": "string", "minLength": 1},
        "required_algorithms": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "gap_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "required_gap_followups": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "required_static_tokens": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        },
        "controls": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "required_outputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "blocked_answer_claims": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "required_boundary_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "scan_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "required_example_sets": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
