{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/resource_lease.schema.json",
  "title": "NoemaForge Resource Lease",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "lease_id",
    "resource_type",
    "resource_key",
    "holder",
    "mode",
    "status",
    "acquired_at",
    "expires_at"
  ],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.resource.lease/v1"
    },
    "kind": {
      "const": "ResourceLease"
    },
    "lease_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_type": {
      "enum": [
        "repo_mutation",
        "github_write",
        "worktree_write",
        "gpu_heavy",
        "cpu_heavy",
        "provider_quota",
        "read_only_repo",
        "human_approval",
        "custom"
      ]
    },
    "resource_key": {
      "type": "string",
      "minLength": 1
    },
    "holder": {
      "type": "object",
      "required": [
        "run_id",
        "worker_id"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "work_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "worker_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "shared",
        "exclusive"
      ]
    },
    "status": {
      "enum": [
        "requested",
        "active",
        "released",
        "expired",
        "revoked"
      ]
    },
    "acquired_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_parallel": {
          "type": "integer",
          "minimum": 1
        },
        "token_budget": {
          "type": "integer",
          "minimum": 0
        },
        "ram_mb": {
          "type": "integer",
          "minimum": 0
        },
        "vram_mb": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
