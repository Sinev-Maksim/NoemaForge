{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/toolproxy_capability_token.schema.json",
  "title": "ToolProxyCapabilityTokenPolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {"const": "noemaforge.toolproxy-capability/v1"},
    "kind": {"const": "ToolProxyCapabilityTokenPolicy"},
    "id": {"type": "string"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "shadow", "stable", "retired"]},
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "require_trace_id",
        "require_registry_attachment",
        "require_policy_schema_runtime_tests",
        "require_docs_and_changelog_refs",
        "required_tool_policy_ref",
        "required_runtime_refs",
        "required_ux_commands",
        "token_controls",
        "required_example_sets"
      ],
      "properties": {
        "mode": {"const": "offline_contract"},
        "activation_state": {"const": "capability_token_issuance_ux"},
        "require_trace_id": {"const": true},
        "require_registry_attachment": {"const": true},
        "require_policy_schema_runtime_tests": {"const": true},
        "require_docs_and_changelog_refs": {"const": true},
        "required_tool_policy_ref": {"type": "string"},
        "required_runtime_refs": {"type": "array", "items": {"type": "string"}, "minItems": 3, "uniqueItems": true},
        "required_ux_commands": {
          "type": "array",
          "items": {"enum": ["issue", "list", "verify", "revoke", "smoke"]},
          "minItems": 5,
          "uniqueItems": true
        },
        "token_controls": {
          "type": "object",
          "required": [
            "short_lived_required",
            "max_default_ttl_sec",
            "default_secret_redaction",
            "full_secret_requires_explicit_flag",
            "persisted_secret_plaintext_allowed",
            "secret_sha256_required",
            "epoch_binding_required",
            "issued_to_binding_required",
            "live_llm_optional",
            "offline_smoke_required",
            "revoke_moves_to_revoked"
          ],
          "properties": {
            "short_lived_required": {"const": true},
            "max_default_ttl_sec": {"type": "integer", "maximum": 600},
            "default_secret_redaction": {"const": true},
            "full_secret_requires_explicit_flag": {"const": true},
            "persisted_secret_plaintext_allowed": {"const": false},
            "secret_sha256_required": {"const": true},
            "epoch_binding_required": {"const": true},
            "issued_to_binding_required": {"const": true},
            "live_llm_optional": {"const": true},
            "offline_smoke_required": {"const": true},
            "revoke_moves_to_revoked": {"const": true}
          },
          "additionalProperties": false
        },
        "required_example_sets": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": false
}
