{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/edge_reference_targets.schema.json",
  "title": "EdgeReferenceTargetsPolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "targets", "refs"],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.edge-reference-targets/v1"
    },
    "kind": {
      "const": "EdgeReferenceTargetsPolicy"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": ["draft", "shadow", "stable", "retired"]
    },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "require_post_mvp_for_orchestration",
        "require_preferred_local_rule_engine",
        "require_ota_reference_only",
        "forbid_first_start_dependency",
        "forbid_required_runtime_dependency",
        "allowed_categories",
        "allowed_statuses",
        "required_targets"
      ],
      "properties": {
        "mode": {
          "const": "offline_contract"
        },
        "require_post_mvp_for_orchestration": {
          "const": true
        },
        "require_preferred_local_rule_engine": {
          "const": true
        },
        "require_ota_reference_only": {
          "const": true
        },
        "forbid_first_start_dependency": {
          "const": true
        },
        "forbid_required_runtime_dependency": {
          "const": true
        },
        "allowed_categories": {
          "type": "array",
          "items": {
            "enum": ["orchestration", "stream_rule_engine", "ota_reference"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowed_statuses": {
          "type": "array",
          "items": {
            "enum": ["post_mvp", "preferred_future", "reference_only"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_targets": {
          "type": "array",
          "items": {
            "enum": ["kubeedge", "ekuiper", "mender", "rauc"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "status",
          "required_for_first_start",
          "required_runtime_dependency",
          "preferred",
          "network_required",
          "local_mvp_alternative_ref",
          "refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "enum": ["orchestration", "stream_rule_engine", "ota_reference"]
          },
          "status": {
            "enum": ["post_mvp", "preferred_future", "reference_only"]
          },
          "required_for_first_start": {
            "const": false
          },
          "required_runtime_dependency": {
            "const": false
          },
          "preferred": {
            "type": "boolean"
          },
          "network_required": {
            "type": "boolean"
          },
          "local_mvp_alternative_ref": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
