{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge.graph_patch_provenance.schema.json",
  "title": "NoemaForge Graph Patch Provenance",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "patch_id",
    "trace_id",
    "source_graph_ref",
    "source_graph_digest",
    "target_graph_ref",
    "created_at",
    "actor_role",
    "review_state",
    "review_decision",
    "rollback_plan",
    "operations"
  ],
  "properties": {
    "apiVersion": { "const": "noemaforge.graph-patch-provenance/v1" },
    "kind": { "const": "GraphPatch" },
    "patch_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "trace_id": { "type": "string", "minLength": 1 },
    "source_graph_ref": { "type": "string", "minLength": 1 },
    "source_graph_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "target_graph_ref": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "actor_role": { "type": "string", "minLength": 1 },
    "review_state": { "enum": ["draft", "review", "approved", "rejected", "applied"] },
    "review_decision": { "type": "string", "minLength": 1 },
    "rollback_plan": {
      "type": "object",
      "required": ["strategy", "pre_apply_snapshot_ref", "revert_patch_ref"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "pre_apply_snapshot_ref": { "type": "string", "minLength": 1 },
        "revert_patch_ref": { "type": "string", "minLength": 1 }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op_id", "op_type", "entity_type", "payload", "provenance"],
        "properties": {
          "op_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
          "op_type": {
            "enum": [
              "add_node",
              "update_node",
              "add_edge",
              "update_edge",
              "annotate_claim",
              "resolve_conflict",
              "attach_artifact"
            ]
          },
          "entity_type": { "type": "string", "minLength": 1 },
          "payload": { "type": "object" },
          "provenance": {
            "type": "object",
            "required": ["source_refs", "artifact_refs", "rationale", "confidence", "created_by_role"],
            "properties": {
              "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "rationale": { "type": "string", "minLength": 1 },
              "confidence": { "type": "string", "minLength": 1 },
              "created_by_role": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
