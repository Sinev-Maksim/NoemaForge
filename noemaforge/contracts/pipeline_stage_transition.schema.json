{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.local/contracts/pipeline_stage_transition.schema.json",
  "title": "NoemaForge pipeline stage transition policy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {"const": "noemaforge.pipeline.stage-transition/v1"},
    "kind": {"const": "PipelineStageTransitionPolicy"},
    "id": {"const": "pipeline-stage-transition-core"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "shadow", "active", "retired"]},
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "require_registry_attachment",
        "require_docs_and_changelog_refs",
        "required_pipeline_ref",
        "required_pipeline_commands",
        "required_event_types",
        "required_outputs",
        "required_refs",
        "controls",
        "required_example_sets"
      ],
      "properties": {
        "mode": {"const": "offline_contract"},
        "activation_state": {"const": "deterministic_stage_transition_commands"},
        "require_registry_attachment": {"const": true},
        "require_docs_and_changelog_refs": {"const": true},
        "required_pipeline_ref": {"type": "string"},
        "required_pipeline_commands": {
          "type": "array",
          "items": {"enum": ["run", "approve", "advance", "pause", "resume", "fail", "event-log", "show"]},
          "minItems": 8,
          "uniqueItems": true
        },
        "required_event_types": {
          "type": "array",
          "items": {"enum": ["pipeline_created", "pipeline_approved", "pipeline_paused", "pipeline_resumed", "pipeline_stage_updated", "pipeline_failed"]},
          "minItems": 6,
          "uniqueItems": true
        },
        "required_outputs": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 7,
          "uniqueItems": true
        },
        "required_refs": {
          "type": "object",
          "required": ["cli", "runtime", "contract_runtime"],
          "properties": {
            "cli": {"type": "string"},
            "runtime": {"type": "string"},
            "contract_runtime": {"type": "string"}
          },
          "additionalProperties": false
        },
        "controls": {
          "type": "object",
          "required": ["stage_validation_required", "event_log_required", "terminal_fail_state_required", "deterministic_state_dir_required", "no_live_host_required", "no_llm_autostart"],
          "properties": {
            "stage_validation_required": {"const": true},
            "event_log_required": {"const": true},
            "terminal_fail_state_required": {"const": true},
            "deterministic_state_dir_required": {"const": true},
            "no_live_host_required": {"const": true},
            "no_llm_autostart": {"const": true}
          },
          "additionalProperties": false
        },
        "required_example_sets": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 8,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
