{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.local/contracts/runtime_observer_cards.schema.json",
  "title": "NoemaForge Runtime Observer Cards Policy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": { "const": "noemaforge.runtime-observer-cards/v1" },
    "kind": { "const": "RuntimeObserverCardsPolicy" },
    "id": { "const": "runtime-observer-cards-core" },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "shadow", "stable", "retired"] },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "endpoint",
        "required_card_ids",
        "required_server_tokens",
        "required_frontend_tokens",
        "required_style_tokens",
        "required_runtime_scripts",
        "required_runtime_tokens",
        "required_docs"
      ],
      "properties": {
        "mode": { "const": "offline_contract" },
        "activation_state": { "const": "gateway_backend_smoke_observer_cards" },
        "require_registry_attachment": { "const": true },
        "require_docs_and_changelog_refs": { "const": true },
        "require_no_live_host_dependency": { "const": true },
        "endpoint": { "const": "/api/runtime/observer-cards" },
        "required_card_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_server_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_frontend_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_style_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_runtime_scripts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_runtime_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_docs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
