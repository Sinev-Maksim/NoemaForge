{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge.model-health-candidate-filter.schema.json",
  "title": "NoemaForge Model Health Candidate Filter Policy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "noemaforge.model-health-candidate-filter/v1"
    },
    "kind": {
      "const": "ModelHealthCandidateFilterPolicy"
    },
    "id": {
      "const": "model-health-candidate-filter-core"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.31\\.21\\.alpha$"
    },
    "status": {
      "enum": ["draft", "shadow", "stable", "retired"]
    },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "require_registry_attachment",
        "require_docs_and_changelog_refs",
        "require_no_live_model_dependency",
        "candidate_map_artifact",
        "health_registry_artifact",
        "failure_report_artifact",
        "exclude_health_states",
        "selected_model_paths",
        "required_runtime_scripts",
        "required_runtime_tokens",
        "required_docs"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "offline_contract"
        },
        "activation_state": {
          "const": "filtered_candidate_map_excludes_failed_runtime_models"
        },
        "require_registry_attachment": {
          "const": true
        },
        "require_docs_and_changelog_refs": {
          "const": true
        },
        "require_no_live_model_dependency": {
          "const": true
        },
        "candidate_map_artifact": {
          "const": "role-candidate-map.filtered.json"
        },
        "health_registry_artifact": {
          "const": "model-health-registry.json"
        },
        "failure_report_artifact": {
          "const": "model-failure-report.json"
        },
        "exclude_health_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["failed_runtime", "failed_any_reason"]
          }
        },
        "selected_model_paths": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "required_runtime_scripts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "required_runtime_tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "required_docs": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "refs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    }
  }
}
