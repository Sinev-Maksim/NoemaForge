{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.local/contracts/release_artifact_name_guard.schema.json",
  "title": "NoemaForge Release Artifact Name Guard Policy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": { "const": "noemaforge.release-artifact-name-guard/v1" },
    "kind": { "const": "ReleaseArtifactNameGuardPolicy" },
    "id": { "const": "release-artifact-name-guard-core" },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "shadow", "stable", "retired"] },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "canonical_changelog_ref",
        "allowed_exact_refs",
        "forbidden_filename_patterns",
        "excluded_dir_names",
        "required_runtime_scripts",
        "required_runtime_tokens",
        "required_docs",
        "required_doc_tokens"
      ],
      "properties": {
        "mode": { "const": "offline_contract" },
        "activation_state": { "const": "canonical_release_history_only" },
        "require_registry_attachment": { "const": true },
        "require_docs_and_changelog_refs": { "const": true },
        "require_no_live_host_dependency": { "const": true },
        "canonical_changelog_ref": { "type": "string", "minLength": 1 },
        "allowed_exact_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "forbidden_filename_patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "excluded_dir_names": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_runtime_scripts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_runtime_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_docs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_doc_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
