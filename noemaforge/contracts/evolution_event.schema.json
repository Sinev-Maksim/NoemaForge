{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.dev/contracts/evolution_event.schema.json",
  "title": "NoemaForge Evolution Event",
  "type": "object",
  "required": ["apiVersion", "kind", "event_id", "run_id", "created_at", "provenance", "event_type", "severity", "message"],
  "properties": {
    "apiVersion": { "const": "noemaforge.evolution-execution/v1" },
    "kind": { "const": "EvolutionEvent" },
    "event_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "work_item_id": { "type": "string" },
    "created_at": { "type": "string", "minLength": 1 },
    "provenance": { "const": "UAT request findings resolution" },
    "event_type": { "enum": ["created", "blocked", "reviewed", "gate_result", "completed"] },
    "severity": { "enum": ["info", "warning", "error", "critical"] },
    "message": { "type": "string", "minLength": 1 },
    "evidence_ref": { "type": "string" }
  },
  "additionalProperties": false
}
