{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/tool_request.schema.json",
  "type": "object",
  "required": ["token", "action", "args", "meta"],
  "properties": {
    "token": {"type": "string"},
    "action": {"type": "string"},
    "args": {"type": "object"},
    "meta": {
      "type": "object",
      "required": ["run_id", "role", "project_id", "trace_id", "stream_id"],
      "properties": {
        "run_id": {"type": "string"},
        "role": {"type": "string"},
        "project_id": {"type": "string"},
        "trace_id": {"type": "string"},
        "stream_id": {"type": "string"},
        "source_format": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
