{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/concept_frame.schema.json",
  "title": "ConceptFramePolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.concept-frame/v1"
    },
    "kind": {
      "const": "ConceptFramePolicy"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": ["draft", "shadow", "stable", "retired"]
    },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "require_trace_id",
        "require_role",
        "require_context",
        "require_options",
        "require_risks",
        "require_recommendation",
        "dangerous_actions_require_admin_approval",
        "pipeline_mutation_requires_rfc",
        "persistence_export_requires_privacy_filter",
        "internet_research_requires_research_packet",
        "uncertainty_requires_honesty_state",
        "allowed_roles",
        "allowed_decision_types",
        "allowed_honesty_states",
        "dangerous_actions",
        "required_example_sets"
      ],
      "properties": {
        "mode": {
          "const": "offline_contract"
        },
        "require_trace_id": {
          "const": true
        },
        "require_role": {
          "const": true
        },
        "require_context": {
          "const": true
        },
        "require_options": {
          "const": true
        },
        "require_risks": {
          "const": true
        },
        "require_recommendation": {
          "const": true
        },
        "dangerous_actions_require_admin_approval": {
          "const": true
        },
        "pipeline_mutation_requires_rfc": {
          "const": true
        },
        "persistence_export_requires_privacy_filter": {
          "const": true
        },
        "internet_research_requires_research_packet": {
          "const": true
        },
        "uncertainty_requires_honesty_state": {
          "const": true
        },
        "allowed_roles": {
          "type": "array",
          "items": {
            "enum": ["admin", "architect"]
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "allowed_decision_types": {
          "type": "array",
          "items": {
            "enum": ["control_plane_task", "architecture_decision", "pipeline_mutation", "persistence_export", "internet_research", "operator_question"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowed_honesty_states": {
          "type": "array",
          "items": {
            "enum": ["sufficient_evidence", "unknown", "need_research", "error_attribution"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "dangerous_actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_example_sets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
