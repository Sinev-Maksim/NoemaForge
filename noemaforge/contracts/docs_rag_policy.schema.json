{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.dev/contracts/docs_rag_policy.schema.json",
  "title": "DocsRAGPolicy",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "id",
    "version",
    "index_version",
    "include_globs",
    "top_k",
    "max_citations",
    "citation_required"
  ],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.docs-rag/v1"
    },
    "kind": {
      "const": "DocsRAGPolicy"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "index_version": {
      "type": "string"
    },
    "include_globs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "max_chars_per_doc": {
      "type": "integer",
      "minimum": 1
    },
    "top_k": {
      "type": "integer",
      "minimum": 1
    },
    "max_citations": {
      "type": "integer",
      "minimum": 1
    },
    "citation_required": {
      "type": "boolean"
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": true
    },
    "reranking": {
      "type": "object",
      "additionalProperties": true
    },
    "answering": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
