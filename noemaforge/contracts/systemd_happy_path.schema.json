{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.local/contracts/systemd_happy_path.schema.json",
  "title": "NoemaForge Systemd Happy Path Policy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "refs", "policy"],
  "properties": {
    "apiVersion": {"const": "noemaforge.systemd-happy-path/v1"},
    "kind": {"const": "SystemdHappyPathPolicy"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,220}$"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "shadow", "stable", "retired"]},
    "refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "required_pipeline_ref",
        "boundary_phrase",
        "required_outputs",
        "controls",
        "required_static_tokens",
        "blocked_happy_path_tokens",
        "required_boundary_refs",
        "scan_refs",
        "required_example_sets"
      ],
      "properties": {
        "mode": {"const": "offline_contract"},
        "activation_state": {"const": "operator_cli_owned_systemd_happy_path"},
        "required_pipeline_ref": {"type": "string", "pattern": "^pipeline:"},
        "require_trace_id": {"const": true},
        "require_registry_attachment": {"const": true},
        "require_docs_and_changelog_refs": {"const": true},
        "require_no_live_dependency": {"const": true},
        "boundary_phrase": {"type": "string", "minLength": 1},
        "required_outputs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "controls": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        },
        "required_static_tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "blocked_happy_path_tokens": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "required_boundary_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "scan_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "required_example_sets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
