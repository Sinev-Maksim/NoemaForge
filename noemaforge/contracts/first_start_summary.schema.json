{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/first_start_summary.schema.json",
  "title": "FirstStartSummaryPolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {"const": "noemaforge.first-start-summary/v1"},
    "kind": {"const": "FirstStartSummaryPolicy"},
    "id": {"type": "string"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "shadow", "stable", "retired"]},
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "require_trace_id",
        "require_registry_attachment",
        "require_policy_schema_runtime_tests",
        "require_docs_and_changelog_refs",
        "required_pipeline_ref",
        "required_runtime_ref",
        "run_grouping",
        "required_markers",
        "required_sections",
        "state_marker_map",
        "required_example_sets"
      ],
      "properties": {
        "mode": {"const": "offline_contract"},
        "activation_state": {"const": "grouped_run_summary"},
        "require_trace_id": {"const": true},
        "require_registry_attachment": {"const": true},
        "require_policy_schema_runtime_tests": {"const": true},
        "require_docs_and_changelog_refs": {"const": true},
        "required_pipeline_ref": {"type": "string"},
        "required_runtime_ref": {"const": "src/first_start_summary.py"},
        "run_grouping": {
          "type": "object",
          "required": ["group_by_start_step", "latest_defaults_to_last_run", "all_includes_every_run", "timeline_uses_latest_run"],
          "properties": {
            "group_by_start_step": {"const": true},
            "latest_defaults_to_last_run": {"const": true},
            "all_includes_every_run": {"const": true},
            "timeline_uses_latest_run": {"const": true}
          },
          "additionalProperties": false
        },
        "required_markers": {
          "type": "array",
          "items": {"enum": ["PASS", "WARN", "FAIL"]},
          "minItems": 3,
          "uniqueItems": true
        },
        "required_sections": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 4,
          "uniqueItems": true
        },
        "state_marker_map": {
          "type": "object",
          "additionalProperties": {"enum": ["PASS", "WARN", "FAIL", "INFO"]}
        },
        "required_example_sets": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
