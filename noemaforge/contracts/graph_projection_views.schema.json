{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.local/contracts/graph_projection_views.schema.json",
  "title": "Graph Projection Views Validation Report",
  "type": "object",
  "required": ["apiVersion", "kind", "ok", "id", "version", "metrics", "failures"],
  "properties": {
    "apiVersion": {"const": "noemaforge.graph-projection-views/v1"},
    "kind": {"const": "GraphProjectionViewsValidationReport"},
    "ok": {"type": "boolean"},
    "id": {"type": "string"},
    "version": {"type": "string"},
    "validated_at": {"type": "string"},
    "metrics": {
      "type": "object",
      "required": ["projection_types", "scenarios", "passing_scenarios", "resolved_refs"],
      "properties": {
        "projection_types": {"type": "integer", "minimum": 4},
        "scenarios": {"type": "integer", "minimum": 1},
        "passing_scenarios": {"type": "integer", "minimum": 0},
        "resolved_refs": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "failures": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
