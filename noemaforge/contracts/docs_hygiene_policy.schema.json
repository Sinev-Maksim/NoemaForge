{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/docs_hygiene_policy.schema.json",
  "title": "DocsHygienePolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.docs-hygiene/v1"
    },
    "kind": {
      "const": "DocsHygienePolicy"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": ["draft", "shadow", "stable", "retired"]
    },
    "policy": {
      "type": "object",
      "required": [
        "approved_markdown_prefixes",
        "allowed_root_markdown",
        "allowed_package_root_markdown",
        "legacy_root_markdown_patterns",
        "canonical_changelog_refs",
        "allowed_parallel_changelog_prefixes",
        "required_canonical_files",
        "required_checked_todo_items"
      ],
      "properties": {
        "approved_markdown_prefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowed_root_markdown": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "allowed_package_root_markdown": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "legacy_root_markdown_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "canonical_changelog_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowed_parallel_changelog_prefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "required_canonical_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_checked_todo_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "label"],
            "properties": {
              "file": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
