{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge.canonical_model_eval_matrix_readiness.schema.json",
  "title": "NoemaForge Canonical Model Evaluation Matrix Readiness Policy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": { "const": "noemaforge.canonical-model-eval-matrix-readiness/v1" },
    "kind": { "const": "CanonicalModelEvalMatrixReadinessPolicy" },
    "id": { "const": "canonical-model-eval-matrix-readiness-core" },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "shadow", "stable", "retired"] },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "completion_state",
        "require_registry_attachment",
        "require_docs_and_changelog_refs",
        "require_no_live_execution",
        "blocked_todo_refs",
        "required_safety_controls",
        "required_dimensions",
        "required_outputs",
        "required_refs"
      ],
      "properties": {
        "mode": { "const": "offline_contract" },
        "activation_state": { "const": "canonical_model_eval_matrix_readiness" },
        "completion_state": { "const": "blocked_until_canonical_model_matrix_evidence" },
        "require_registry_attachment": { "const": true },
        "require_docs_and_changelog_refs": { "const": true },
        "require_no_live_execution": { "const": true },
        "blocked_todo_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_safety_controls": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "required_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "runtime_devices",
              "target_evidence_required",
              "source_refs",
              "evidence",
              "completion_gates"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
              "title": { "type": "string", "minLength": 1 },
              "runtime_devices": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["cpu", "gpu"] }
              },
              "target_evidence_required": { "const": true },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "completion_gates": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "required_outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
