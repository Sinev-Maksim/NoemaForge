{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.local/contracts/model_profile_selection.schema.json",
  "title": "NoemaForge Model Profile Selection",
  "type": "object",
  "required": ["apiVersion", "kind", "profile", "fetch_candidates", "stage_roles", "selection_policy"],
  "properties": {
    "apiVersion": {"const": "noemaforge.model-profile/v1"},
    "kind": {"const": "ModelProfileManifest"},
    "profile": {"enum": ["minimal", "balanced", "writer", "research", "gpu-heavy"]},
    "fetch_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_hint", "source", "auto_download"],
        "properties": {
          "artifact_hint": {"type": "string"},
          "source": {"const": "operator_staged_or_existing_vault"},
          "auto_download": {"const": false}
        }
      }
    },
    "stage_roles": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "selection_policy": {
      "type": "object",
      "required": ["operator_chooses_profile_not_individual_files", "candidate_hints_are_filters_not_downloads"],
      "properties": {
        "operator_chooses_profile_not_individual_files": {"const": true},
        "candidate_hints_are_filters_not_downloads": {"const": true}
      }
    }
  }
}
