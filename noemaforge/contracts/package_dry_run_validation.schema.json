{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/package_dry_run_validation.schema.json",
  "title": "PackageDryRunValidationPolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {"const": "noemaforge.package-dry-run/v1"},
    "kind": {"const": "PackageDryRunValidationPolicy"},
    "id": {"type": "string"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "shadow", "stable", "retired"]},
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "require_trace_id",
        "require_registry_attachment",
        "require_docs_and_changelog_refs",
        "required_pipeline_ref",
        "required_scripts",
        "required_setup_flags",
        "required_uninstall_flags",
        "dry_run_controls",
        "required_example_sets"
      ],
      "properties": {
        "mode": {"const": "offline_contract"},
        "activation_state": {"const": "install_uninstall_dry_run_tests"},
        "require_trace_id": {"const": true},
        "require_registry_attachment": {"const": true},
        "require_docs_and_changelog_refs": {"const": true},
        "required_pipeline_ref": {"type": "string"},
        "required_scripts": {
          "type": "object",
          "required": ["setup", "installer", "uninstall"],
          "properties": {
            "setup": {"type": "string"},
            "installer": {"type": "string"},
            "uninstall": {"type": "string"}
          },
          "additionalProperties": false
        },
        "required_setup_flags": {"type": "array", "items": {"type": "string"}, "minItems": 5, "uniqueItems": true},
        "required_uninstall_flags": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
        "dry_run_controls": {
          "type": "object",
          "required": [
            "setup_dry_run_exits_before_installer_exec",
            "setup_non_dry_run_requires_root",
            "setup_recursion_guard_required",
            "setup_selftest_checks_install_and_uninstall_syntax",
            "setup_dry_run_no_rm_rf",
            "uninstall_dry_run_required",
            "uninstall_reports_no_destructive_actions",
            "uninstall_dry_run_no_rm_rf"
          ],
          "properties": {
            "setup_dry_run_exits_before_installer_exec": {"const": true},
            "setup_non_dry_run_requires_root": {"const": true},
            "setup_recursion_guard_required": {"const": true},
            "setup_selftest_checks_install_and_uninstall_syntax": {"const": true},
            "setup_dry_run_no_rm_rf": {"const": true},
            "uninstall_dry_run_required": {"const": true},
            "uninstall_reports_no_destructive_actions": {"const": true},
            "uninstall_dry_run_no_rm_rf": {"const": true}
          },
          "additionalProperties": false
        },
        "required_example_sets": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": false
}
