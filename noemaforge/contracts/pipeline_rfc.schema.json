{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/pipeline_rfc.schema.json",
  "title": "PipelineRFCPolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.pipeline-rfc/v1"
    },
    "kind": {
      "const": "PipelineRFCPolicy"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": ["draft", "shadow", "stable", "retired"]
    },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "require_trace_id",
        "rfc_required_for_mutation",
        "dry_run_required",
        "dry_run_side_effects_allowed",
        "eval_evidence_required",
        "rollback_plan_required",
        "explicit_approval_required",
        "apply_blocked_without_approval",
        "dangerous_action_review_required",
        "mutation_types",
        "required_stage_order",
        "required_eval_checks",
        "approval_states",
        "rfc_statuses",
        "required_example_sets"
      ],
      "properties": {
        "mode": {
          "const": "offline_contract"
        },
        "require_trace_id": {
          "const": true
        },
        "rfc_required_for_mutation": {
          "const": true
        },
        "dry_run_required": {
          "const": true
        },
        "dry_run_side_effects_allowed": {
          "const": false
        },
        "eval_evidence_required": {
          "const": true
        },
        "rollback_plan_required": {
          "const": true
        },
        "explicit_approval_required": {
          "const": true
        },
        "apply_blocked_without_approval": {
          "const": true
        },
        "dangerous_action_review_required": {
          "const": true
        },
        "mutation_types": {
          "type": "array",
          "items": {
            "enum": ["pipeline_config", "role_flow", "tool_policy", "model_route", "code_patch"]
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "required_stage_order": {
          "type": "array",
          "items": {
            "enum": ["rfc", "dry_run", "eval", "rollback", "approval", "apply"]
          },
          "minItems": 6,
          "uniqueItems": true
        },
        "required_eval_checks": {
          "type": "array",
          "items": {
            "enum": ["pipeline_eval", "safety_eval", "rollback_plan"]
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "approval_states": {
          "type": "array",
          "items": {
            "enum": ["not_requested", "requested", "approved", "rejected"]
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "rfc_statuses": {
          "type": "array",
          "items": {
            "enum": ["draft", "ready_for_review", "ready_to_apply", "blocked", "applied"]
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "required_example_sets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
