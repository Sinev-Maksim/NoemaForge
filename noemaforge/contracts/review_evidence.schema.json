{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"noemaforge://contracts/review_evidence.schema.json","title":"NoemaForge Review Evidence","type":"object","required":["apiVersion","kind","review_id","run_id","work_item_id","reviewed_head","reviewer_persona","reviewer_independent","verdict","findings","checks","reviewed_at","stale"],"properties":{"apiVersion":{"const":"noemaforge.evolution.review-evidence/v1"},"kind":{"const":"ReviewEvidence"},"review_id":{"type":"string","minLength":1},"run_id":{"type":"string","minLength":1},"work_item_id":{"type":"string","minLength":1},"reviewed_head":{"type":"string","pattern":"^[0-9a-f]{40}$"},"reviewer_persona":{"type":"string","minLength":1},"mutator_persona":{"type":["string","null"]},"reviewer_independent":{"const":true},"verdict":{"enum":["pass","changes_required","blocked"]},"findings":{"type":"array","items":{"type":"object","required":["severity","summary"],"properties":{"severity":{"enum":["info","low","medium","high","critical"]},"summary":{"type":"string","minLength":1},"evidence_ref":{"type":["string","null"]}},"additionalProperties":false}},"checks":{"type":"array","items":{"type":"string"},"uniqueItems":true},"reviewed_at":{"type":"string","format":"date-time"},"stale":{"const":false}},"additionalProperties":false}
