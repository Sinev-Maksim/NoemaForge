{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.local/contracts/setup_mode_matrix.schema.json",
  "title": "NoemaForge Setup Mode Matrix Policy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {"const": "noemaforge.setup-modes/v1"},
    "kind": {"const": "SetupModeMatrixPolicy"},
    "id": {"const": "setup-mode-matrix-core"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "shadow", "stable", "retired"]},
    "policy": {
      "type": "object",
      "required": ["mode", "activation_state", "required_pipeline_ref", "mode_matrix_ref", "setup_script_ref", "boundary_phrase", "required_modes", "mode_requirements", "required_boundary_refs", "required_example_sets"],
      "properties": {
        "mode": {"const": "offline_contract"},
        "activation_state": {"const": "explicit_setup_mode_matrix"},
        "required_pipeline_ref": {"type": "string", "pattern": "^pipeline:"},
        "mode_matrix_ref": {"const": "configs/setup-modes.json"},
        "setup_script_ref": {"const": "setup.sh"},
        "require_registry_attachment": {"const": true},
        "require_docs_and_changelog_refs": {"const": true},
        "require_no_live_dependency": {"const": true},
        "boundary_phrase": {"type": "string", "minLength": 60},
        "required_modes": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "mode_requirements": {"type": "object"},
        "required_boundary_refs": {"type": "array", "minItems": 6, "items": {"type": "string"}},
        "required_example_sets": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "refs": {"type": "array", "minItems": 12, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
