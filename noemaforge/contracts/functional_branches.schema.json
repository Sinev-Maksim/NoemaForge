{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FunctionalBranches",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "branches"
  ],
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "const": "FunctionalBranches"
    },
    "branches": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "manifest"
        ],
        "properties": {
          "manifest": {
            "type": "string"
          }
        }
      }
    }
  }
}