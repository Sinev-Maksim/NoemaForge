{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.dev/contracts/evolution_agent_result.schema.json",
  "title": "NoemaForge Evolution Agent Result",
  "type": "object",
  "required": ["apiVersion", "kind", "result_id", "request_id", "run_id", "created_at", "provenance", "agent_role", "status", "artifacts", "machine_readable_result"],
  "properties": {
    "apiVersion": { "const": "noemaforge.evolution-execution/v1" },
    "kind": { "const": "EvolutionAgentResult" },
    "result_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "provenance": { "const": "UAT request findings resolution" },
    "agent_role": { "type": "string", "minLength": 1 },
    "status": { "enum": ["succeeded", "blocked", "failed"] },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "machine_readable_result": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
