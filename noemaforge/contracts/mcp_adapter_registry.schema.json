{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/mcp_adapter_registry.schema.json",
  "title": "MCPAdapterRegistry",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "policy", "adapters"],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.mcp-adapter-registry/v1"
    },
    "kind": {
      "const": "MCPAdapterRegistry"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,119}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "required": [
        "default_state",
        "default_network",
        "require_trace_id",
        "require_capability_token",
        "require_registry_entry",
        "require_operator_review_for_enable",
        "allowed_transports",
        "blocked_transports",
        "max_tool_risk"
      ],
      "properties": {
        "default_state": {
          "const": "disabled"
        },
        "default_network": {
          "const": "deny"
        },
        "require_trace_id": {
          "const": true
        },
        "require_capability_token": {
          "const": true
        },
        "require_registry_entry": {
          "const": true
        },
        "require_operator_review_for_enable": {
          "const": true
        },
        "allowed_transports": {
          "type": "array",
          "items": {
            "enum": ["stdio", "unix_socket", "tcp", "http", "websocket"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "blocked_transports": {
          "type": "array",
          "items": {
            "enum": ["stdio", "unix_socket", "tcp", "http", "websocket"]
          },
          "uniqueItems": true
        },
        "max_tool_risk": {
          "enum": ["low", "medium", "high", "critical"]
        }
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "state",
          "transport",
          "risk",
          "network",
          "capability_scopes",
          "tool_allowlist",
          "trace_required",
          "capability_token_required",
          "registry_entry_required",
          "registry_ref",
          "audit_logging",
          "sandbox",
          "review",
          "rollback_plan",
          "refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.:-]{0,119}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": ["disabled", "shadow", "canary", "enabled", "retired"]
          },
          "transport": {
            "enum": ["stdio", "unix_socket", "tcp", "http", "websocket"]
          },
          "mode": {
            "type": "string"
          },
          "handler": {
            "type": "string"
          },
          "risk": {
            "enum": ["low", "medium", "high", "critical"]
          },
          "network": {
            "const": "deny"
          },
          "capability_scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:-]{0,80}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "tool_allowlist": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:-]{0,80}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "trace_required": {
            "const": true
          },
          "capability_token_required": {
            "const": true
          },
          "registry_entry_required": {
            "const": true
          },
          "registry_ref": {
            "type": "string",
            "pattern": "^[a-z-]+:[A-Za-z0-9_.:-]+:[A-Za-z0-9_.:-]+$"
          },
          "audit_logging": {
            "const": true
          },
          "sandbox": {
            "type": "object",
            "required": ["profile", "write", "egress"],
            "properties": {
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "write": {
                "const": false
              },
              "egress": {
                "const": "deny"
              }
            },
            "additionalProperties": false
          },
          "review": {
            "type": "object",
            "required": ["required", "route", "reviewers"],
            "properties": {
              "required": {
                "const": true
              },
              "route": {
                "type": "string",
                "minLength": 1
              },
              "reviewers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "evidence_ref": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "rollback_plan": {
            "type": "string",
            "minLength": 20
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
