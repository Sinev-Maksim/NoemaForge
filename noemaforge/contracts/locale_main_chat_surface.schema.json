{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/locale_main_chat_surface.schema.json",
  "title": "LocaleMainChatSurfacePolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {"const": "noemaforge.locale-main-chat-surface/v1"},
    "kind": {"const": "LocaleMainChatSurfacePolicy"},
    "id": {"const": "locale-main-chat-surface-core"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "shadow", "stable", "retired"]},
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "local_first_default",
        "require_registry_attachment",
        "require_docs_and_changelog_refs",
        "api_path",
        "required_locales",
        "required_message_keys",
        "required_frontend_tokens",
        "required_main_chat_ids",
        "ru_disallowed_fragments",
        "required_docs"
      ],
      "properties": {
        "mode": {"const": "offline_contract"},
        "local_first_default": {"const": true},
        "require_registry_attachment": {"const": true},
        "require_docs_and_changelog_refs": {"const": true},
        "api_path": {"const": "/api/locales"},
        "required_locales": {"type": "array", "items": {"type": "string"}, "minItems": 10, "uniqueItems": true},
        "required_message_keys": {"type": "array", "items": {"type": "string"}, "minItems": 16, "uniqueItems": true},
        "required_frontend_tokens": {"type": "array", "items": {"type": "string"}, "minItems": 6, "uniqueItems": true},
        "required_main_chat_ids": {"type": "array", "items": {"type": "string"}, "minItems": 11, "uniqueItems": true},
        "ru_disallowed_fragments": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "required_docs": {"type": "array", "items": {"type": "string"}, "minItems": 5, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": false
}
