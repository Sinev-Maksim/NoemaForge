{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/typed_governance_track.schema.json",
  "title": "TypedGovernanceTrackPolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.typed-governance/v1"
    },
    "kind": {
      "const": "TypedGovernanceTrackPolicy"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": ["draft", "shadow", "stable", "retired"]
    },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "require_trace_id",
        "require_dependency_order",
        "require_registry_attachment",
        "require_policy_schema_runtime_tests",
        "require_docs_and_changelog_refs",
        "required_pipeline_ref",
        "required_stage_order",
        "required_contracts",
        "required_example_sets"
      ],
      "properties": {
        "mode": {
          "const": "offline_contract"
        },
        "require_trace_id": {
          "const": true
        },
        "require_dependency_order": {
          "const": true
        },
        "require_registry_attachment": {
          "const": true
        },
        "require_policy_schema_runtime_tests": {
          "const": true
        },
        "require_docs_and_changelog_refs": {
          "const": true
        },
        "required_pipeline_ref": {
          "type": "string"
        },
        "required_stage_order": {
          "type": "array",
          "items": {
            "enum": [
              "concept_frame",
              "sense_state_privacy",
              "drive_state",
              "honesty_protocol",
              "slop_critic",
              "detection_verdict",
              "research_packet",
              "pipeline_rfc"
            ]
          },
          "minItems": 8,
          "uniqueItems": true
        },
        "required_contracts": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": ["stage", "eval_pack_ref", "policy_ref", "schema_ref", "runtime_ref", "test_refs"],
            "properties": {
              "stage": {
                "type": "string"
              },
              "eval_pack_ref": {
                "type": "string"
              },
              "policy_ref": {
                "type": "string"
              },
              "schema_ref": {
                "type": "string"
              },
              "runtime_ref": {
                "type": "string"
              },
              "test_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 3,
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "required_example_sets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
