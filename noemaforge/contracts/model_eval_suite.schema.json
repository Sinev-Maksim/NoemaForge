{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.dev/contracts/model_eval_suite.schema.json",
  "title": "ModelEvalSuite",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "suites"
  ],
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "const": "ModelEvalSuite"
    },
    "suites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cases": {
            "type": "object",
            "properties": {
              "llm": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/case"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/case"
                      }
                    }
                  }
                ]
              },
              "embed": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/case"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/case"
                      }
                    }
                  }
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "case": {
      "type": "object",
      "required": [
        "id",
        "messages"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "expect": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}
