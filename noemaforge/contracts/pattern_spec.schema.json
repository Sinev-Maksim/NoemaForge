{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/pattern_spec.schema.json",
  "type": "object",
  "required": [
    "spec_version",
    "pattern_id",
    "version",
    "title",
    "steps"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": [
        "v1"
      ]
    },
    "pattern_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "io_profile": {
      "type": "object",
      "properties": {
        "read_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dbs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "resources_profile": {
      "type": "object",
      "properties": {
        "cpu_cores": {
          "type": "integer",
          "minimum": 1
        },
        "ram_mib": {
          "type": "integer",
          "minimum": 128
        },
        "gpu": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "never",
                "prefer",
                "hard"
              ]
            },
            "vram_mib_min": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string",
          "enum": [
            "deny",
            "egress_emulated",
            "allow"
          ]
        },
        "exec_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "kind"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "tool",
              "subpattern",
              "gate"
            ]
          },
          "tool": {
            "type": "string",
            "description": "ToolProxy action id (e.g., fs.read, exec.run)"
          },
          "args": {
            "type": "object",
            "description": "Tool arguments template/values",
            "additionalProperties": true
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "artifact",
                    "index",
                    "db",
                    "report"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "verifiers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
