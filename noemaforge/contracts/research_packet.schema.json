{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/research_packet.schema.json",
  "title": "ResearchPacketPolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.research-packet/v1"
    },
    "kind": {
      "const": "ResearchPacketPolicy"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": ["draft", "shadow", "stable", "retired"]
    },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "no_network_during_validation",
        "require_trace_id",
        "source_allowlist_required",
        "freshness_bounded",
        "citations_required",
        "no_uncited_claims",
        "require_primary_or_official_sources",
        "max_source_age_days",
        "default_freshness_window_days",
        "min_sources",
        "allowed_domains",
        "required_source_kinds",
        "packet_statuses",
        "required_example_sets"
      ],
      "properties": {
        "mode": {
          "const": "offline_contract"
        },
        "no_network_during_validation": {
          "const": true
        },
        "require_trace_id": {
          "const": true
        },
        "source_allowlist_required": {
          "const": true
        },
        "freshness_bounded": {
          "const": true
        },
        "citations_required": {
          "const": true
        },
        "no_uncited_claims": {
          "const": true
        },
        "require_primary_or_official_sources": {
          "const": true
        },
        "max_source_age_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        },
        "default_freshness_window_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        },
        "min_sources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_source_kinds": {
          "type": "array",
          "items": {
            "enum": ["official_docs", "repository", "local_evidence"]
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "packet_statuses": {
          "type": "array",
          "items": {
            "enum": ["draft", "ready", "needs_refresh", "blocked"]
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "required_example_sets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
