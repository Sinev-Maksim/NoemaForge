{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/slop_critic.schema.json",
  "title": "SlopCriticPolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {
      "const": "noemaforge.slop-critic/v1"
    },
    "kind": {
      "const": "SlopCriticPolicy"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": ["draft", "shadow", "stable", "retired"]
    },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "advisory_by_default",
        "no_single_detector_truth",
        "require_trace_id",
        "require_slop_score",
        "require_critic_stack",
        "require_detection_verdict",
        "require_critic_aggregation_before_final",
        "bands",
        "band_weights",
        "thresholds",
        "actions",
        "critic_types",
        "verdict_decisions",
        "required_example_sets"
      ],
      "properties": {
        "mode": {
          "const": "offline_contract"
        },
        "advisory_by_default": {
          "const": true
        },
        "no_single_detector_truth": {
          "const": true
        },
        "require_trace_id": {
          "const": true
        },
        "require_slop_score": {
          "const": true
        },
        "require_critic_stack": {
          "const": true
        },
        "require_detection_verdict": {
          "const": true
        },
        "require_critic_aggregation_before_final": {
          "const": true
        },
        "bands": {
          "type": "array",
          "items": {
            "enum": ["genericity", "repetition", "unsupportedness", "provenance_gap"]
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "band_weights": {
          "type": "object",
          "required": ["genericity", "repetition", "unsupportedness", "provenance_gap"],
          "properties": {
            "genericity": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "repetition": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "unsupportedness": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "provenance_gap": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          },
          "additionalProperties": false
        },
        "thresholds": {
          "type": "object",
          "required": ["allow_max", "revise_max", "abstain_max"],
          "properties": {
            "allow_max": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "revise_max": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "abstain_max": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          },
          "additionalProperties": false
        },
        "actions": {
          "type": "array",
          "items": {
            "enum": ["allow", "revise", "abstain", "escalate"]
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "critic_types": {
          "type": "array",
          "items": {
            "enum": ["text", "provenance", "slop"]
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "verdict_decisions": {
          "type": "array",
          "items": {
            "enum": ["clean", "advisory_ai_likely", "advisory_manipulated", "unknown"]
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "required_example_sets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
