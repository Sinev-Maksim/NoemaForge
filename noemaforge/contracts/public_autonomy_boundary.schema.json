{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.local/contracts/public_autonomy_boundary.schema.json",
  "title": "NoemaForge Public Autonomy Boundary Policy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "refs", "policy"],
  "properties": {
    "apiVersion": {"const": "noemaforge.public-autonomy-boundary/v1"},
    "kind": {"const": "PublicAutonomyBoundaryPolicy"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,220}$"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "shadow", "stable", "retired"]},
    "refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "required_pipeline_ref",
        "boundary_phrase",
        "required_qualifiers",
        "required_outputs",
        "controls",
        "blocked_public_claims",
        "required_self_improvement_policy",
        "required_boundary_refs",
        "scan_refs",
        "required_example_sets"
      ],
      "properties": {
        "mode": {"const": "offline_contract"},
        "activation_state": {"const": "alpha_lab_only_not_public_ready"},
        "required_pipeline_ref": {"type": "string", "pattern": "^pipeline:"},
        "require_trace_id": {"const": true},
        "require_registry_attachment": {"const": true},
        "require_docs_and_changelog_refs": {"const": true},
        "require_no_live_dependency": {"const": true},
        "boundary_phrase": {"type": "string", "minLength": 1},
        "required_qualifiers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "required_outputs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "controls": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        },
        "blocked_public_claims": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "required_self_improvement_policy": {"type": "object"},
        "required_boundary_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "scan_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "required_example_sets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
