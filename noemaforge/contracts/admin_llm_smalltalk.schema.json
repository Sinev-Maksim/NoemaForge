{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.local/contracts/admin_llm_smalltalk.schema.json",
  "title": "NoemaForge Admin LLM Smalltalk Policy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": { "const": "noemaforge.admin-llm-smalltalk/v1" },
    "kind": { "const": "AdminLLMSmalltalkPolicy" },
    "id": { "const": "admin-llm-smalltalk-core" },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "shadow", "stable", "retired"] },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "required_backends",
        "required_gui_tokens",
        "required_runtime_scripts",
        "required_runtime_tokens",
        "required_docs",
        "smalltalk_examples",
        "explicit_control_examples"
      ],
      "properties": {
        "mode": { "const": "offline_contract" },
        "activation_state": { "const": "optional_llm_chat_with_deterministic_fallback" },
        "require_registry_attachment": { "const": true },
        "require_docs_and_changelog_refs": { "const": true },
        "require_no_live_llm_dependency": { "const": true },
        "require_control_plane_preserved": { "const": true },
        "required_backends": {
          "type": "array",
          "minItems": 2,
          "items": { "enum": ["llm_chat", "deterministic_fallback"] },
          "uniqueItems": true
        },
        "required_gui_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_runtime_scripts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_runtime_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_docs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "smalltalk_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "explicit_control_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
