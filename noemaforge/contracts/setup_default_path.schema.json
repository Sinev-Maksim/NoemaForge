{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noemaforge.local/contracts/setup_default_path.schema.json",
  "title": "Setup Default Path Validation Report",
  "type": "object",
  "required": ["apiVersion", "kind", "ok", "id", "version", "metrics", "failures"],
  "properties": {
    "apiVersion": {"const": "noemaforge.setup-default-path/v1"},
    "kind": {"const": "SetupDefaultPathValidationReport"},
    "ok": {"type": "boolean"},
    "id": {"type": "string"},
    "version": {"type": "string"},
    "validated_at": {"type": "string"},
    "metrics": {
      "type": "object",
      "required": ["canonical_steps", "required_modes", "onboarding_refs", "resolved_refs"],
      "properties": {
        "canonical_steps": {"type": "integer", "minimum": 5},
        "required_modes": {"type": "integer", "minimum": 4},
        "onboarding_refs": {"type": "integer", "minimum": 4},
        "boundary_refs": {"type": "integer", "minimum": 1},
        "resolved_refs": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "failures": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
