{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noemaforge://contracts/dashboard_launcher.schema.json",
  "title": "DashboardLauncherPolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "version", "status", "policy", "refs"],
  "properties": {
    "apiVersion": {"const": "noemaforge.dashboard-launcher/v1"},
    "kind": {"const": "DashboardLauncherPolicy"},
    "id": {"type": "string"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "shadow", "stable", "retired"]},
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "activation_state",
        "require_trace_id",
        "require_registry_attachment",
        "require_docs_and_changelog_refs",
        "required_pipeline_ref",
        "required_cli_commands",
        "required_refs",
        "launcher_controls",
        "required_example_sets"
      ],
      "properties": {
        "mode": {"const": "offline_contract"},
        "activation_state": {"const": "local_dashboard_launcher"},
        "require_trace_id": {"const": true},
        "require_registry_attachment": {"const": true},
        "require_docs_and_changelog_refs": {"const": true},
        "required_pipeline_ref": {"type": "string"},
        "required_cli_commands": {
          "type": "array",
          "items": {"enum": ["path", "state", "serve", "start", "stop", "status", "autostart-enable", "autostart-disable", "autostart-status"]},
          "minItems": 9,
          "uniqueItems": true
        },
        "required_refs": {
          "type": "object",
          "required": ["cli", "launcher", "dashboard_ui", "state_runtime", "gui_runtime"],
          "properties": {
            "cli": {"type": "string"},
            "launcher": {"type": "string"},
            "dashboard_ui": {"type": "string"},
            "state_runtime": {"type": "string"},
            "gui_runtime": {"type": "string"}
          },
          "additionalProperties": false
        },
        "launcher_controls": {
          "type": "object",
          "required": [
            "writes_dashboard_state",
            "serves_static_ui",
            "localhost_only",
            "operator_writable_state_required",
            "no_llm_autostart",
            "no_media_autostart",
            "background_pidfile_required",
            "status_command_required",
            "user_systemd_autostart_required",
            "autostart_dry_run_required",
            "no_root_required_for_user_autostart"
          ],
          "properties": {
            "writes_dashboard_state": {"const": true},
            "serves_static_ui": {"const": true},
            "localhost_only": {"const": true},
            "operator_writable_state_required": {"const": true},
            "no_llm_autostart": {"const": true},
            "no_media_autostart": {"const": true},
            "background_pidfile_required": {"const": true},
            "status_command_required": {"const": true},
            "user_systemd_autostart_required": {"const": true},
            "autostart_dry_run_required": {"const": true},
            "no_root_required_for_user_autostart": {"const": true}
          },
          "additionalProperties": false
        },
        "required_example_sets": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": false
}
