[Unit]
Description=NoemaForge GUI safe autostart attempt (timer-driven, non-blocking)
Documentation=file:/usr/local/share/noemaforge/docs/AUTOSTART_BOOT_MODES_0.30.20.md
Wants=network-online.target
After=network-online.target gdm.service gdm3.service display-manager.service nvidia-gui-preflight.service
ConditionPathExists=/etc/noemaforge/boot-mode

[Service]
Type=oneshot
ExecStart=/opt/noemaforge/tools/prep/noemaforge-autostart-safe.sh --mode gui --nonfatal-gui-wait
TimeoutStartSec=10min
RemainAfterExit=no

# Do not enable this service directly in graphical.target.
# Enable noemaforge-autostart-gui.timer instead.
