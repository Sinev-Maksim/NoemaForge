# === NoemaForge File Header ===
# File: systemd/noemaforge-modelscan.timer
# Zone: release/package
# Version: 0.33.0
# Created: 2026-06-08
# Modified: 2026-06-08
# Purpose: Schedule the ModelStore registry scan (noemaforge-modelscan.service).
# Inputs: none.
# Outputs: periodic activation of the scan service.
# Side effects: none beyond timer scheduling.
# Tests: Syntax validation plus the release setup selftest, consistency-audit and targeted smoke checks.
# Notes: Code comments are English-only; user-facing localized text belongs in docs/i18n or locale JSON files.
# === End NoemaForge File Header ===
[Unit]
Description=NoemaForge ModelScan Timer

[Timer]
OnBootSec=60
OnUnitActiveSec=10m
Persistent=true
Unit=noemaforge-modelscan.service

[Install]
WantedBy=timers.target
