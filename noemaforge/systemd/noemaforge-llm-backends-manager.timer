[Unit]
Description=NoemaForge LLM Backends Manager Timer

[Timer]
OnBootSec=90
OnUnitActiveSec=5m
Persistent=true
Unit=noemaforge-llm-backends-manager.service

[Install]
WantedBy=timers.target
