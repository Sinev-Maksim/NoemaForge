[Unit]
Description=NoemaForge ToolProxy
After=network.target noemaforge-llm-gateway.service
Wants=noemaforge-llm-gateway.service
ConditionPathExists=/opt/noemaforge/src/toolproxy.py

[Service]
Type=simple
User=noemaforge
Group=noemaforge
Environment=NOEMAFORGE_ROOT=/opt/noemaforge
Environment=NOEMAFORGE_STATE=/var/lib/noemaforge
Environment=NOEMAFORGE_GATEWAY_SOCKET=/run/noemaforge/llm/gateway.sock
Environment=NOEMAFORGE_TOOLPROXY_SOCKET=/run/noemaforge/toolproxy.sock
ExecStartPre=+/usr/bin/install -d -o noemaforge -g noemaforge -m 0755 /run/noemaforge /run/noemaforge/llm /run/noemaforge/llm/backends /var/lib/noemaforge
ExecStart=/usr/bin/python3 /opt/noemaforge/src/toolproxy.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
