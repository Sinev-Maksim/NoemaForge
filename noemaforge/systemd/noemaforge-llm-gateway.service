[Unit]
Description=NoemaForge LLM Gateway
After=network.target
ConditionPathExists=/opt/noemaforge/bin/noemaforge-llm-gateway

[Service]
Type=simple
User=noemaforge
Group=noemaforge
Environment=NOEMAFORGE_GATEWAY_SOCKET=/run/noemaforge/llm/gateway.sock
Environment=NOEMAFORGE_BACKENDS=main:/run/noemaforge/llm/backends/main.sock
Environment=NOEMAFORGE_DEFAULT_MODEL=main
Environment=NOEMAFORGE_MAX_BODY_BYTES=10485760
EnvironmentFile=-/etc/default/noemaforge-runtime
ExecStartPre=+/usr/bin/install -d -o noemaforge -g noemaforge -m 0755 /run/noemaforge /run/noemaforge/llm /run/noemaforge/llm/backends /var/lib/noemaforge
ExecStart=/opt/noemaforge/bin/noemaforge-llm-gateway
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
