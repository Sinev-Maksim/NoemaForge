# NoemaForge SELinux module (skeleton)
#
# This is NOT a complete policy. It is a starting point.
# You will need to generate allow rules from audit logs (ausearch/audit2allow)
# and then tighten them.

policy_module(noemaforge, 0.1.0)

require {
  type init_t;
  class process { transition sigchld }; 
}

