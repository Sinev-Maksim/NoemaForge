{
  "apiVersion": "noemaforge.engineering-guardrails/v1",
  "version": "1.0.0",
  "classification": "UAT request findings resolution",
  "source_status": {
    "agreed": "Recovered from the NoemaForge/Night Watch conversation chain and live evidence.",
    "recommended": "New generalized guardrail derived from repeated failures and the research self-audit."
  },
  "control": {
    "stagnation_limit_per_task": {
      "default": 4,
      "minimum": 1,
      "zero_means_unlimited": false,
      "status": "agreed"
    },
    "traversal_depth_limit": {
      "default": 0,
      "minimum": 0,
      "zero_means_unlimited": true,
      "status": "agreed"
    },
    "global_iteration_limit": {
      "default": 0,
      "minimum": 0,
      "zero_means_unlimited": true,
      "status": "agreed"
    },
    "charge_product_attempt_only_after_candidate_materialized": {
      "value": true,
      "status": "recommended",
      "rationale": "Provider/transport failure must not consume product-task stagnation budget."
    }
  },
  "workspace": {
    "isolated_worktree_required": true,
    "exact_base_required": true,
    "unexpected_changes": "fail_closed",
    "test_files_immutable_during_repair": true,
    "bytecode_hygiene_required": true,
    "status": "agreed"
  },
  "side_effects": {
    "host_path_mutation_forbidden": true,
    "registry_mutation_forbidden": true,
    "global_execution_policy_mutation_forbidden": true,
    "global_git_config_mutation_forbidden": true,
    "remote_git_write_requires_explicit_authorization": true,
    "gcp_write_requires_explicit_authorization": true,
    "status": "agreed"
  },
  "external_process_contract": {
    "unbounded_payload_in_argv_forbidden": true,
    "large_prompt_transport": [
      "stdin_utf8_bytes",
      "utf8_file",
      "bounded_structured_ipc"
    ],
    "stdin_text_writer_default_encoding_forbidden": true,
    "utf8_byte_roundtrip_canary_required": true,
    "interactive_process_requires_real_tty": true,
    "native_stderr_must_be_classified_not_treated_as_automatic_failure": true,
    "status": "recommended",
    "derived_from": [
      "NW-UAT-WIN-029",
      "NW-UAT-WIN-032",
      "NW-UAT-WIN-042",
      "NW-UAT-WIN-046",
      "NW-UAT-WIN-047"
    ]
  },
  "paths": {
    "filesystem_operations_use_native_path_objects": true,
    "external_identifiers_and_artifact_keys_use_posix_slashes": true,
    "do_not_force_posix_for_real_filesystem_access": true,
    "status": "agreed+clarified"
  },
  "runtime_discovery": {
    "discover_installed_runtime_outside_path": true,
    "do_not_change_host_path_or_registry": true,
    "portable_fallback_hash_pinned": true,
    "portable_fallback_only_if_installed_runtime_unusable": true,
    "status": "agreed"
  },
  "agents": {
    "persona_is_not_provider": true,
    "persona_is_not_independence": true,
    "provider_late_bound": true,
    "capability_scoped_skills": true,
    "implementer_self_review_invalid": true,
    "same_provider_model_session_not_multiple_independent_votes": true,
    "fresh_same_provider_session_is_local_cocheck_not_independent_vote": true,
    "optional_reviewer_never_blocks_unless_policy_requires": true,
    "status": "agreed"
  },
  "security": {
    "skill_access_decision": [
      "persona_purpose",
      "capability",
      "skill_danger"
    ],
    "avoid_exception_list_as_primary_model": true,
    "dangerous_skill_requires_compatible_persona_and_policy": true,
    "status": "agreed"
  },
  "review": {
    "exact_candidate_sha_binding_required": true,
    "candidate_change_invalidates_only_affected_reviews": true,
    "blocked_review_short_circuits": [
      "reproducer",
      "cost_estimator",
      "budget_router",
      "gcp"
    ],
    "markdown_only_independent_cocheck_required": true,
    "coderabbit_required_if_prior_affected_finding_originated_from_coderabbit": true,
    "coderabbit_code_config_infra_exact_sha_normally_required": true,
    "git_helper_is_deterministic_integrity_check_not_semantic_llm_vote": true,
    "status": "agreed"
  },
  "pipeline": {
    "ordered": [
      "finding",
      "work_item",
      "minimal_fix",
      "local_deterministic_checks",
      "affected_independent_review",
      "review_gate",
      "reproducer",
      "cost_estimation",
      "budget_route",
      "gcp_gate_if_required",
      "formal_result",
      "next_iteration"
    ],
    "fix_before_reproducer": true,
    "review_before_reproducer": true,
    "status": "agreed"
  },
  "budget": {
    "cheap_max_usd": 1,
    "normal_max_usd": 10,
    "pricy_min_exclusive_usd": 10,
    "pricy_max_exclusive_usd": 100,
    "out_of_budget_min_usd": 100,
    "cheap_if_fits": "auto_start_notice",
    "normal_if_fits": "auto_start_prominent_notice",
    "pricy_if_fits": "approval_required_yield",
    "out_of_budget_if_remaining_ge_10": "decompose",
    "out_of_budget_if_remaining_lt_10": "hard_stop",
    "estimate_route_uses_upper_bound": true,
    "zero_estimate_does_not_imply_no_execution": true,
    "status": "agreed"
  },
  "uat_findings": {
    "label": "UAT request findings resolution",
    "dual_track": [
      "third_party_prerequisite",
      "package_fallback"
    ],
    "generalize_root_cause_not_single_symptom": true,
    "new_regression_guard_required": true,
    "status": "agreed"
  },
  "comments": {
    "explain_invariant_and_why": true,
    "avoid_narrating_obvious_code": true,
    "workaround_comment_requires": [
      "finding_id",
      "reason",
      "removal_condition"
    ],
    "version_history_belongs_in_changelog_not_inline_code_comment": true,
    "security_boundary_comment_required": true,
    "status": "recommended"
  },
  "terminal": {
    "terminal_states_signal_user": true,
    "ready_signal_json": true,
    "compact_handoff_archive": true,
    "archive_sha256": true,
    "print_local_path_and_file_uri": true,
    "exclude_disposable_worktrees": true,
    "status": "agreed"
  },
  "interfaces": {
    "single_source_machine_readable_contract_required": true,
    "duplicated_cross_component_enum_forbidden": true,
    "callsite_literals_must_be_subset_of_contract": true,
    "cross_file_parity_preflight_required": true,
    "status": "recommended",
    "derived_from": [
      "NW-UAT-WIN-049"
    ]
  },
  "package_closure": {
    "runtime_dependency_contract_required": true,
    "manifest_consistency_not_sufficient": true,
    "build_fails_on_missing_required_runtime_file": true,
    "startup_closure_preflight_before_worktree_or_agents": true,
    "structural_failure_short_circuits_expensive_work": true,
    "immutable_inputs_exist_before_hash_or_test": true,
    "status": "recommended",
    "derived_from": [
      "NW-UAT-WIN-050",
      "NW-UAT-WIN-051"
    ]
  },
  "machine_verdicts": {
    "designated_output_channel_only": true,
    "stderr_never_part_of_verdict": true,
    "single_structured_result_required": true,
    "exact_candidate_and_evidence_binding_required": true,
    "contradictory_or_malformed": "unavailable_fail_closed",
    "status": "recommended",
    "derived_from": [
      "NW-UAT-WIN-052"
    ]
  },
  "review_surfaces": {
    "same_provider_local_cocheck_is_optional": true,
    "same_provider_local_cocheck_is_not_independent": true,
    "exact_patch_snapshot_may_be_embedded": true,
    "provider_unavailable_does_not_become_pass": true,
    "provider_unavailable_does_not_replace_remote_independent_review": true,
    "status": "recommended",
    "derived_from": [
      "NW-UAT-WIN-053"
    ]
  },
  "repair_plane_separation": {
    "control_plane_failures_never_become_product_tasks": true,
    "control_plane_retries_separate": true,
    "control_plane_failure_may_not_modify_product_code": true,
    "control_plane_failure_may_not_charge_product_stagnation": true,
    "status": "recommended",
    "derived_from": [
      "NW-UAT-WIN-054"
    ]
  },
  "proposal_preimage": {
    "canonical_lf_matching": true,
    "preserve_original_newline_style": true,
    "mixed_newline_target_fail_closed": true,
    "status": "recommended",
    "derived_from": [
      "NW-UAT-WIN-055"
    ]
  }
}
