{
  "apiVersion": "noemaforge.media-adapter-telemetry/v1",
  "kind": "MediaAdapterTelemetryPolicy",
  "id": "media-adapter-telemetry-core",
  "version": "0.32.1",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "local_first_default": true,
    "require_registry_attachment": true,
    "require_docs_and_changelog_refs": true,
    "require_media_catalog_attachment": true,
    "required_metrics": [
      "wall_time_ms",
      "cpu_time_ms",
      "max_rss_mb",
      "disk_read_bytes",
      "disk_write_bytes",
      "artifact_bytes",
      "status"
    ],
    "optional_hardware_metrics": [
      "gpu_vram_mb",
      "gpu_utilization_pct",
      "ecc_error_count"
    ],
    "required_selftest_cases": [
      "metadata_probe",
      "plan_only_smoke",
      "artifact_review_stub"
    ],
    "required_media_adapters": [
      {
        "pipeline_id": "voice_generation",
        "catalog_id": "audio.tts_generate",
        "adapter_family": "tts",
        "telemetry_profile": "plan_only_media_adapter",
        "live_backend_required": false
      },
      {
        "pipeline_id": "music_generation",
        "catalog_id": "audio.music_generate",
        "adapter_family": "music",
        "telemetry_profile": "plan_only_media_adapter",
        "live_backend_required": false
      },
      {
        "pipeline_id": "photo_generation",
        "catalog_id": "image.photo_generate",
        "adapter_family": "image_generation",
        "telemetry_profile": "plan_only_media_adapter",
        "live_backend_required": false
      },
      {
        "pipeline_id": "video_generation",
        "catalog_id": "video.generate",
        "adapter_family": "video_generation",
        "telemetry_profile": "plan_only_media_adapter",
        "live_backend_required": false
      },
      {
        "pipeline_id": "image_analysis",
        "catalog_id": "image.metadata_and_caption",
        "adapter_family": "vision",
        "telemetry_profile": "metadata_and_caption_adapter",
        "live_backend_required": false
      },
      {
        "pipeline_id": "camera_mask_bridge",
        "catalog_id": "video_call.masks_virtual_camera",
        "adapter_family": "segmentation_masks",
        "telemetry_profile": "privacy_gated_plan_only_adapter",
        "live_backend_required": false
      }
    ],
    "required_example_sets": [
      "prelaunch/governance/media_adapter_telemetry.example.json"
    ]
  },
  "refs": [
    "noemaforge/configs/media-adapter-telemetry-policy.json",
    "noemaforge/contracts/media_adapter_telemetry.schema.json",
    "noemaforge/src/media_adapter_telemetry_runtime.py",
    "noemaforge/src/selftest_runtime.py",
    "noemaforge/tests/test_media_adapter_telemetry_runtime.py",
    "noemaforge/tests/test_media_adapter_telemetry_qa.py",
    "noemaforge/tests/test_media_adapter_telemetry_performance.py",
    "prelaunch/governance/media_adapter_telemetry.example.json",
    "noemaforge/configs/media-pipeline-catalog.json",
    "noemaforge/configs/pipelines.json",
    "noemaforge/configs/selftest-case-catalog.json",
    "noemaforge/docs/README.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}

