{
  "apiVersion": "noemaforge.job-progress-stream/v1",
  "kind": "JobProgressStreamPolicy",
  "id": "job-progress-stream-core",
  "version": "0.32.2",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "activation_state": "sse_snapshot_stream",
    "require_registry_attachment": true,
    "require_docs_and_changelog_refs": true,
    "require_no_live_host_dependency": true,
    "stream_endpoint": "/api/jobs/stream",
    "stream_content_type": "text/event-stream",
    "required_events": [
      "jobs_snapshot",
      "job_progress"
    ],
    "required_server_tokens": [
      "/api/jobs/stream",
      "text/event-stream",
      "job_stream_events",
      "sse_event",
      "jobs_snapshot",
      "job_progress"
    ],
    "required_frontend_tokens": [
      "EventSource",
      "/api/jobs/stream",
      "jobs_snapshot",
      "job_progress",
      "renderJobs"
    ],
    "required_runtime_scripts": [
      "noemaforge/src/job_progress_stream_runtime.py"
    ],
    "required_runtime_tokens": [
      "validate_job_progress_stream_policy",
      "build_job_stream_events",
      "sse_snapshot_stream",
      "text/event-stream"
    ],
    "required_docs": [
      "docs/README.md",
      "docs/TODO.md",
      "docs/reference/PROJECT_CONTEXT.md",
      "docs/backlog/ROADMAP_AND_TODO.md",
      "docs/history/CHANGELOG.md"
    ]
  },
  "refs": [
    "noemaforge/configs/job-progress-stream-policy.json",
    "noemaforge/contracts/job_progress_stream.schema.json",
    "noemaforge/src/job_progress_stream_runtime.py",
    "noemaforge/src/admin_gui_server.py",
    "noemaforge/templates/pipeline-dashboard/app.js",
    "noemaforge/tests/test_job_progress_stream_runtime.py",
    "noemaforge/tests/test_job_progress_stream_qa.py",
    "noemaforge/tests/test_job_progress_stream_performance.py",
    "prelaunch/governance/job_progress_stream.example.json",
    "noemaforge/docs/README.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}

