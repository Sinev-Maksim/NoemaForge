{
  "apiVersion": "noemaforge.edge-tinyml-ota-pack/v1",
  "kind": "EdgeTinyMLOTAPackPolicy",
  "id": "edge-tinyml-ota-pack-core",
  "version": "0.32.0.alpha",
  "status": "shadow",
  "summary": "Edge/TinyML/OTA pack aggregates MQTT/serial Sense ingestion, TinyML validation, gateway inference, edge rules, signed manifests and OTA rollback into one offline release contract.",
  "policy": {
    "mode": "offline_aggregate_contract",
    "activation_state": "aggregate_components_shadow_ready",
    "require_docs_and_changelog_refs": true,
    "require_no_live_edge_dependency": true,
    "require_mqtt_serial_ingestion": true,
    "require_tinyml_validation": true,
    "require_gateway_inference": true,
    "require_rules_engine": true,
    "require_manifest_signing": true,
    "require_ota_rollback": true,
    "forbid_live_device_required": true,
    "required_components": [
      {
        "id": "sense-layer-edge-core",
        "config": "noemaforge/configs/sense-layer-edge.json",
        "runtime": "noemaforge/src/sense_layer_edge_runtime.py",
        "capabilities": ["mqtt", "serial", "source_trust_schema"]
      },
      {
        "id": "tinyml-node-core",
        "config": "noemaforge/configs/tinyml-node-policy.json",
        "runtime": "noemaforge/src/tinyml_node_runtime.py",
        "capabilities": ["golden_vectors", "latency_budget", "ram_arena_budget", "model_hash"]
      },
      {
        "id": "gateway-inference-service-core",
        "config": "noemaforge/configs/gateway-inference-service.json",
        "runtime": "noemaforge/src/gateway_inference_service_runtime.py",
        "capabilities": ["rest", "mqtt", "health", "ready", "metrics", "manifest_only_model_loading"]
      },
      {
        "id": "edge-rules-engine-core",
        "config": "noemaforge/configs/edge-rules-engine-policy.json",
        "runtime": "noemaforge/src/edge_rules_engine_runtime.py",
        "capabilities": ["whitebox_fallback", "rule_guard", "thresholds", "drift_flags"]
      },
      {
        "id": "ota-update-layer-core",
        "config": "noemaforge/configs/ota-update-layer.json",
        "runtime": "noemaforge/src/ota_update_layer_runtime.py",
        "capabilities": ["staged_rollout", "rollback_bundle", "health_gate", "ci_release_evidence"]
      },
      {
        "id": "edge-reference-targets-core",
        "config": "noemaforge/configs/edge-reference-targets.json",
        "runtime": "noemaforge/src/edge_reference_targets_runtime.py",
        "capabilities": ["reference_only", "local_mvp_alternative", "no_hard_dependency"]
      }
    ],
    "required_pack_tokens": [
      "MQTT/serial",
      "TinyML validation",
      "gateway inference",
      "rules",
      "manifest signing",
      "OTA rollback"
    ]
  },
  "refs": [
    "noemaforge/configs/edge-tinyml-ota-pack-policy.json",
    "noemaforge/src/edge_tinyml_ota_pack_runtime.py",
    "noemaforge/tests/test_edge_tinyml_ota_pack_runtime.py",
    "noemaforge/tests/test_edge_tinyml_ota_pack_qa.py",
    "noemaforge/tests/test_edge_tinyml_ota_pack_performance.py",
    "noemaforge/configs/sense-layer-edge.json",
    "noemaforge/configs/tinyml-node-policy.json",
    "noemaforge/configs/gateway-inference-service.json",
    "noemaforge/configs/edge-rules-engine-policy.json",
    "noemaforge/configs/ota-update-layer.json",
    "noemaforge/configs/edge-reference-targets.json",
    "noemaforge/src/sense_layer_edge_runtime.py",
    "noemaforge/src/tinyml_node_runtime.py",
    "noemaforge/src/gateway_inference_service_runtime.py",
    "noemaforge/src/edge_rules_engine_runtime.py",
    "noemaforge/src/ota_update_layer_runtime.py",
    "noemaforge/src/edge_reference_targets_runtime.py",
    "docs/wiki/edge/edge-tinyml-ota-roadmap-0.31.13.alpha-patched1.md",
    "TODO.md",
    "noemaforge/TODO.md",
    "docs/TODO.md",
    "noemaforge/docs/TODO.md",
    "docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "docs/history/CHANGELOG.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}

