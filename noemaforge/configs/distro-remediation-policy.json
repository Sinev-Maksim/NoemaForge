{
  "apiVersion": "noemaforge.distro-remediation/v1",
  "kind": "DistroRemediationPolicy",
  "id": "distro-remediation-core",
  "version": "0.32.1",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "activation_state": "distro_detection_missing_dependency_remediation",
    "require_docs_and_changelog_refs": true,
    "require_no_live_host_dependency": true,
    "supported_families": ["debian", "fedora", "arch", "suse"],
    "package_managers": {
      "debian": "apt-get",
      "fedora": "dnf",
      "arch": "pacman",
      "suse": "zypper"
    },
    "required_dependency_commands": [
      "jq",
      "curl",
      "git",
      "rsync",
      "python3",
      "bwrap",
      "ffmpeg",
      "v4l2-ctl",
      "cmake",
      "go",
      "findmnt",
      "systemctl"
    ],
    "required_preflight_flags": [
      "--remediation-plan",
      "--apply-remediation",
      "--yes-i-understand-package-manager-changes"
    ],
    "required_apply_gates": [
      "NOEMAFORGE_ALLOW_PACKAGE_REMEDIATION=1",
      "root privileges",
      "explicit yes flag"
    ],
    "required_json_fields": [
      "distro",
      "remediation",
      "family",
      "package_manager",
      "missing_commands",
      "install_command"
    ],
    "required_scripts": [
      "noemaforge/tools/prep/noemaforge-trixie-preflight.sh",
      "noemaforge/tools/prep/noemaforge-first-launch.sh",
      "noemaforge/bin/noemaforge"
    ],
    "required_packages": {
      "debian": ["jq", "curl", "git", "rsync", "python3", "python3-yaml", "bubblewrap", "ffmpeg", "v4l-utils", "golang-go", "cmake", "ntfs-3g"],
      "fedora": ["jq", "curl", "git", "rsync", "python3-pyyaml", "bubblewrap", "ffmpeg", "v4l-utils", "golang", "cmake", "ntfs-3g"],
      "arch": ["jq", "curl", "git", "rsync", "python-yaml", "bubblewrap", "ffmpeg", "v4l-utils", "go", "cmake", "ntfs-3g"],
      "suse": ["jq", "curl", "git", "rsync", "python3-PyYAML", "bubblewrap", "ffmpeg", "v4l-utils", "go", "cmake", "ntfs-3g"]
    }
  },
  "refs": [
    "noemaforge/configs/distro-remediation-policy.json",
    "noemaforge/src/distro_remediation_runtime.py",
    "noemaforge/tests/test_distro_remediation_runtime.py",
    "noemaforge/tests/test_distro_remediation_qa.py",
    "noemaforge/tests/test_distro_remediation_performance.py",
    "noemaforge/tools/prep/noemaforge-trixie-preflight.sh",
    "noemaforge/tools/prep/noemaforge-first-launch.sh",
    "noemaforge/bin/noemaforge",
    "TODO.md",
    "noemaforge/TODO.md",
    "docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "docs/history/CHANGELOG.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}

