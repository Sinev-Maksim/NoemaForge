{
  "apiVersion": "noemaforge.toolproxy-live-llm-smoke-readiness/v1",
  "kind": "ToolProxyLiveLlmSmokeReadinessPolicy",
  "id": "toolproxy-live-llm-smoke-readiness-core",
  "version": "0.32.2",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "activation_state": "patched10_toolproxy_live_llm_smoke_readiness",
    "completion_state": "blocked_until_target_toolproxy_live_llm_smoke_evidence",
    "require_registry_attachment": true,
    "require_docs_and_changelog_refs": true,
    "require_no_live_execution": true,
    "blocked_todo_refs": [
      "Run live ToolProxy socket + `llm.chat` smoke on NoemaForge with `noemaforge toolproxy smoke --live-llm`."
    ],
    "required_safety_controls": {
      "no_auto_live_execution": true,
      "target_machine_required": true,
      "operator_approval_required": true,
      "toolproxy_service_required": true,
      "llm_chat_scope_required": true,
      "redacted_token_required": true,
      "archive_required": true,
      "local_validator_has_no_subprocess": true
    },
    "required_checks": [
      {
        "id": "target-toolproxy-socket-baseline",
        "title": "Target ToolProxy service and socket baseline",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "systemctl is-active noemaforge-toolproxy.service || true",
          "noemaforge toolproxy status --json",
          "ss -lx | grep noemaforge-toolproxy || true"
        ],
        "evidence": [
          "toolproxy_service_state",
          "toolproxy_status_json",
          "toolproxy_socket_state",
          "target_boot_id"
        ],
        "completion_gates": [
          "toolproxy_service_recorded",
          "socket_state_recorded",
          "status_json_archived",
          "evidence_file_archived"
        ]
      },
      {
        "id": "operator-approval",
        "title": "Operator approval scoped to ToolProxy live LLM smoke",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "printf '%s\\n' 'operator approves live ToolProxy socket plus llm.chat smoke'"
        ],
        "evidence": [
          "operator_approval_record",
          "approved_scope",
          "approved_target_host"
        ],
        "completion_gates": [
          "operator_approval_recorded",
          "scope_limited_to_toolproxy_live_llm_smoke",
          "evidence_file_archived"
        ]
      },
      {
        "id": "llm-chat-scope-binding",
        "title": "Operator-approved llm.chat capability binding",
        "target_evidence_required": true,
        "requires_operator_approval": true,
        "commands": [
          "noemaforge toolproxy capability issue --scope llm.chat --ttl 120 --json"
        ],
        "evidence": [
          "capability_issue_json",
          "issued_scope",
          "issued_ttl_seconds",
          "redacted_token_preview"
        ],
        "completion_gates": [
          "operator_approval_recorded",
          "scope_matches_llm_chat",
          "ttl_within_limit",
          "token_secret_redacted",
          "evidence_file_archived"
        ]
      },
      {
        "id": "live-llm-smoke",
        "title": "Operator-approved ToolProxy live LLM smoke",
        "target_evidence_required": true,
        "requires_operator_approval": true,
        "commands": [
          "noemaforge toolproxy smoke --live-llm --json"
        ],
        "evidence": [
          "toolproxy_smoke_json",
          "llm_chat_result",
          "model_name_or_ref",
          "smoke_exit_code",
          "capability_token_redacted"
        ],
        "completion_gates": [
          "operator_approval_recorded",
          "smoke_command_completed",
          "llm_chat_result_recorded",
          "token_secret_redacted",
          "evidence_file_archived"
        ]
      },
      {
        "id": "post-smoke-token-revocation",
        "title": "Capability token revocation after live smoke",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "noemaforge toolproxy capability revoke --token-id <token-id> --json",
          "noemaforge toolproxy capability verify --token-id <token-id> --json"
        ],
        "evidence": [
          "revoke_json",
          "post_revoke_verify_json",
          "token_hash_only_record",
          "secret_scan_summary"
        ],
        "completion_gates": [
          "revoke_command_completed",
          "post_revoke_verify_rejected",
          "token_secret_not_archived",
          "evidence_file_archived"
        ]
      },
      {
        "id": "live-smoke-archive",
        "title": "Redacted ToolProxy live LLM smoke archive",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "sudo noemaforge forensics --include-toolproxy-live-llm",
          "sha256sum <toolproxy-live-llm-smoke-bundle>"
        ],
        "evidence": [
          "forensics_bundle_path",
          "bundle_sha256",
          "live_smoke_transcript",
          "redaction_manifest"
        ],
        "completion_gates": [
          "bundle_exists",
          "bundle_sha256_recorded",
          "secrets_redacted",
          "canonical_docs_updated_after_review",
          "evidence_file_archived"
        ]
      }
    ],
    "required_outputs": [
      "toolproxy_live_llm_smoke_summary",
      "blocked_completion_notice",
      "target_toolproxy_live_llm_command_manifest",
      "evidence_requirements",
      "registry_attachment",
      "docs_changelog_trace"
    ],
    "required_refs": [
      "noemaforge/configs/toolproxy-live-llm-smoke-readiness-policy.json",
      "noemaforge/contracts/toolproxy_live_llm_smoke_readiness.schema.json",
      "noemaforge/src/toolproxy_live_llm_smoke_readiness_runtime.py",
      "noemaforge/tests/test_toolproxy_live_llm_smoke_readiness_runtime.py",
      "noemaforge/tests/test_toolproxy_live_llm_smoke_readiness_qa.py",
      "noemaforge/tests/test_toolproxy_live_llm_smoke_readiness_performance.py",
      "prelaunch/governance/toolproxy_live_llm_smoke_readiness.example.json",
      "noemaforge/configs/target-live-validation-readiness-policy.json",
      "noemaforge/configs/toolproxy-capability-live-smoke-readiness-policy.json",
      "noemaforge/configs/toolproxy-capability-token-policy.json",
      "noemaforge/src/target_live_validation_readiness_runtime.py",
      "noemaforge/src/toolproxy_capability_live_smoke_readiness_runtime.py",
      "noemaforge/src/toolproxy_capability_token_runtime.py",
      "noemaforge/docs/wiki/operations/recovery-stability-trixie.md",
      "noemaforge/docs/README.md",
      "noemaforge/docs/TODO.md",
      "noemaforge/docs/reference/PROJECT_CONTEXT.md",
      "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
      "noemaforge/docs/history/CHANGELOG.md"
    ]
  },
  "refs": [
    "noemaforge/configs/toolproxy-live-llm-smoke-readiness-policy.json",
    "noemaforge/contracts/toolproxy_live_llm_smoke_readiness.schema.json",
    "noemaforge/src/toolproxy_live_llm_smoke_readiness_runtime.py",
    "noemaforge/tests/test_toolproxy_live_llm_smoke_readiness_runtime.py",
    "noemaforge/tests/test_toolproxy_live_llm_smoke_readiness_qa.py",
    "noemaforge/tests/test_toolproxy_live_llm_smoke_readiness_performance.py",
    "prelaunch/governance/toolproxy_live_llm_smoke_readiness.example.json",
    "noemaforge/configs/target-live-validation-readiness-policy.json",
    "noemaforge/configs/toolproxy-capability-live-smoke-readiness-policy.json",
    "noemaforge/configs/toolproxy-capability-token-policy.json",
    "noemaforge/src/target_live_validation_readiness_runtime.py",
    "noemaforge/src/toolproxy_capability_live_smoke_readiness_runtime.py",
    "noemaforge/src/toolproxy_capability_token_runtime.py",
    "noemaforge/docs/wiki/operations/recovery-stability-trixie.md",
    "noemaforge/docs/README.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}
