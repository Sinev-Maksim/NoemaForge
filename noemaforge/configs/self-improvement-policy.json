{
  "version": "0.32.2",
  "apiVersion": "noemaforge/v1",
  "kind": "SelfImprovementPolicy",
  "default_mode": "measured_review",
  "rules": [
    "run selftest before accepting optimization",
    "compare with baseline",
    "generate wiki incremental patch",
    "block apply on failed regression unless admin overrides"
  ],
  "auto_rollback": {
    "enabled_by_default": false,
    "block_apply_on_failed_cases": true,
    "block_apply_on_resource_regression": true,
    "requires_admin_approval": true
  },
  "notes": [
    "0.32.1 includes code-dev QA sub-team and GUI recovery compatibility checks"
  ]
}

