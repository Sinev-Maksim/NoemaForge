{
  "apiVersion": "noemaforge.post-reboot-service-health-readiness/v1",
  "kind": "PostRebootServiceHealthReadinessPolicy",
  "id": "post-reboot-service-health-readiness-core",
  "version": "0.32.2",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "activation_state": "patched10_post_reboot_service_health_readiness",
    "completion_state": "blocked_until_target_post_reboot_service_health_evidence",
    "require_registry_attachment": true,
    "require_docs_and_changelog_refs": true,
    "require_no_live_execution": true,
    "blocked_todo_refs": [
      "Confirm post-reboot health of `noemaforge-llama@main`, gateway, and ToolProxy on NoemaForge."
    ],
    "required_safety_controls": {
      "no_auto_live_execution": true,
      "target_machine_required": true,
      "operator_approval_required": true,
      "post_reboot_evidence_required": true,
      "main_backend_manual_start_required": true,
      "gateway_health_required": true,
      "toolproxy_health_required": true,
      "socket_evidence_required": true,
      "archive_required": true,
      "local_validator_has_no_subprocess": true
    },
    "required_checks": [
      {
        "id": "post-reboot-baseline",
        "title": "Post-reboot target baseline",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "cat /proc/sys/kernel/random/boot_id",
          "systemctl is-system-running || true",
          "systemctl --failed --no-pager || true"
        ],
        "evidence": ["boot_id", "system_running_state", "failed_units"],
        "completion_gates": ["boot_id_recorded", "system_state_recorded", "failed_units_recorded", "evidence_file_archived"]
      },
      {
        "id": "gateway-service-health",
        "title": "Gateway service health",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "systemctl is-active noemaforge-llm-gateway.service || true",
          "systemctl status noemaforge-llm-gateway.service --no-pager -l || true"
        ],
        "evidence": ["gateway_service_state", "gateway_status_excerpt"],
        "completion_gates": ["service_state_recorded", "gateway_status_recorded", "evidence_file_archived"]
      },
      {
        "id": "main-backend-service-health",
        "title": "Manual main backend service health",
        "target_evidence_required": true,
        "requires_operator_approval": true,
        "commands": [
          "sudo systemctl start noemaforge-llama@main.service",
          "systemctl is-active noemaforge-llama@main.service || true",
          "systemctl status noemaforge-llama@main.service --no-pager -l || true",
          "sudo systemctl stop noemaforge-llama@main.service"
        ],
        "evidence": ["operator_approval_record", "main_backend_service_state", "main_backend_status_excerpt", "main_backend_stop_result"],
        "completion_gates": ["manual_start_approval_recorded", "service_state_recorded", "main_backend_status_recorded", "manual_stop_recorded", "evidence_file_archived"]
      },
      {
        "id": "toolproxy-service-health",
        "title": "ToolProxy service health",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "systemctl is-active noemaforge-toolproxy.service || true",
          "systemctl status noemaforge-toolproxy.service --no-pager -l || true"
        ],
        "evidence": ["toolproxy_service_state", "toolproxy_status_excerpt"],
        "completion_gates": ["service_state_recorded", "toolproxy_status_recorded", "evidence_file_archived"]
      },
      {
        "id": "socket-api-smoke",
        "title": "Gateway and ToolProxy socket/API smoke evidence",
        "target_evidence_required": true,
        "requires_operator_approval": true,
        "commands": [
          "noemaforge status --json",
          "noemaforge gateway health --json || true",
          "noemaforge toolproxy status --json || true"
        ],
        "evidence": ["operator_approval_record", "socket_state", "gateway_health_json", "toolproxy_status_json"],
        "completion_gates": ["operator_approval_recorded", "socket_state_recorded", "gateway_health_recorded", "toolproxy_status_recorded", "evidence_file_archived"]
      },
      {
        "id": "service-health-archive",
        "title": "Post-reboot service health evidence archive",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "sudo noemaforge forensics --include-live-validation --include-install-validation"
        ],
        "evidence": ["forensics_bundle_path", "bundle_sha256", "redaction_manifest", "operator_review_note"],
        "completion_gates": ["bundle_exists", "bundle_sha256_recorded", "secrets_redacted", "canonical_docs_updated_after_review"]
      }
    ],
    "required_outputs": [
      "post_reboot_service_health_summary",
      "blocked_completion_notice",
      "target_health_command_manifest",
      "evidence_requirements",
      "registry_attachment",
      "docs_changelog_trace"
    ],
    "required_refs": [
      "noemaforge/configs/post-reboot-service-health-readiness-policy.json",
      "noemaforge/contracts/post_reboot_service_health_readiness.schema.json",
      "noemaforge/src/post_reboot_service_health_readiness_runtime.py",
      "prelaunch/governance/post_reboot_service_health_readiness.example.json",
      "noemaforge/configs/post-reboot-validation-archive-readiness-policy.json",
      "noemaforge/configs/target-live-validation-readiness-policy.json",
      "noemaforge/src/post_reboot_validation_archive_readiness_runtime.py",
      "noemaforge/src/target_live_validation_readiness_runtime.py",
      "noemaforge/docs/wiki/operations/recovery-stability-trixie.md",
      "noemaforge/docs/README.md",
      "noemaforge/docs/TODO.md",
      "noemaforge/docs/reference/PROJECT_CONTEXT.md",
      "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
      "noemaforge/docs/history/CHANGELOG.md"
    ]
  },
  "refs": [
    "noemaforge/configs/post-reboot-service-health-readiness-policy.json",
    "noemaforge/contracts/post_reboot_service_health_readiness.schema.json",
    "noemaforge/src/post_reboot_service_health_readiness_runtime.py",
    "noemaforge/tests/test_post_reboot_service_health_readiness_runtime.py",
    "noemaforge/tests/test_post_reboot_service_health_readiness_qa.py",
    "noemaforge/tests/test_post_reboot_service_health_readiness_performance.py",
    "prelaunch/governance/post_reboot_service_health_readiness.example.json",
    "noemaforge/configs/post-reboot-validation-archive-readiness-policy.json",
    "noemaforge/configs/target-live-validation-readiness-policy.json",
    "noemaforge/src/post_reboot_validation_archive_readiness_runtime.py",
    "noemaforge/src/target_live_validation_readiness_runtime.py",
    "noemaforge/docs/wiki/operations/recovery-stability-trixie.md",
    "noemaforge/docs/README.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}

