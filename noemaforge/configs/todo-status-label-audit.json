{
  "apiVersion": "noemaforge.docs/v1",
  "kind": "TodoStatusLabelAudit",
  "id": "todo-status-label-audit-core",
  "version": "0.32.0.alpha",
  "status": "shadow",
  "principle": "Checked active TODO lines must carry explicit status labels so contract, runtime, target, roadmap, blocked and documentation states are not conflated.",
  "policy": {
    "mode": "offline_docs_contract",
    "active_todo_files": [
      "noemaforge/docs/TODO.md",
      "noemaforge/docs/backlog/CURRENT_0.32.1_TODO.md",
      "noemaforge/docs/backlog/ROADMAP_AND_TODO.md"
    ],
    "historical_archives_excluded": [
      "noemaforge/docs/backlog/HISTORICAL_TODO_ARCHIVE.md"
    ],
    "allowed_status_labels": [
      "done-contract",
      "done-runtime",
      "target-open",
      "roadmap",
      "blocked",
      "docs-open"
    ],
    "checked_lines_require_done_label": true,
    "unchecked_lines_require_open_or_blocked_label": true,
    "forbid_bare_checked_tasks": true
  },
  "example_lines": [
    {
      "line": "- [x] [done-contract] Add executable contract coverage.",
      "expected": "allow"
    },
    {
      "line": "- [ ] [target-open] Validate on target hardware.",
      "expected": "allow"
    },
    {
      "line": "- [x] Add ambiguous closure.",
      "expected": "deny",
      "expected_failures": [
        "checked_task_missing_done_label"
      ]
    },
    {
      "line": "- [ ] Add unlabeled open work.",
      "expected": "deny",
      "expected_failures": [
        "open_task_missing_status_label"
      ]
    }
  ],
  "refs": [
    "noemaforge/configs/todo-status-label-audit.json",
    "helpers/todo_status_label_audit.mjs",
    "helpers/todo_status_label_audit.qa.test.mjs",
    "helpers/todo_status_label_audit.performance.test.mjs",
    "noemaforge/docs/wiki/quality/todo-status-label-discipline.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/backlog/CURRENT_0.32.1_TODO.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}
