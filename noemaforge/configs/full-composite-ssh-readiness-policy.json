{
  "apiVersion": "noemaforge.full-composite-ssh-readiness/v1",
  "kind": "FullCompositeSshReadinessPolicy",
  "id": "full-composite-ssh-readiness-core",
  "version": "0.32.2",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "activation_state": "patched10_full_composite_ssh_readiness",
    "completion_state": "blocked_until_target_ssh_evidence",
    "require_registry_attachment": true,
    "require_docs_and_changelog_refs": true,
    "require_no_live_execution": true,
    "blocked_todo_refs": [
      "Validate full-composite real run with SSH available."
    ],
    "required_safety_controls": {
      "no_auto_ssh_execution": true,
      "target_machine_required": true,
      "operator_approval_required": true,
      "no_credentials_in_policy": true,
      "known_host_fingerprint_required": true,
      "ssh_transcript_required": true,
      "full_composite_target_run_readiness_required": true,
      "local_validator_has_no_subprocess": true
    },
    "required_checks": [
      {
        "id": "ssh-service-baseline",
        "title": "SSH service and listener baseline",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "systemctl status ssh.service --no-pager -l",
          "ss -tlnp | grep ':22' || true",
          "sudo noemaforge trixie-preflight --json"
        ],
        "evidence": ["ssh_service_state", "ssh_listen_socket", "trixie_preflight_json"],
        "completion_gates": ["ssh_service_state_recorded", "ssh_port_or_socket_recorded", "preflight_json_archived", "evidence_file_archived"]
      },
      {
        "id": "secure-access-plan",
        "title": "Operator-approved secure SSH access plan",
        "target_evidence_required": true,
        "requires_operator_approval": true,
        "commands": [
          "ssh -o BatchMode=yes -o StrictHostKeyChecking=yes <operator-approved-target> true"
        ],
        "evidence": ["operator_approved_ssh_identity", "known_host_fingerprint", "no_plaintext_credentials", "batch_mode_probe_result"],
        "completion_gates": ["operator_approval_recorded", "known_host_fingerprint_recorded", "no_secret_material_archived", "evidence_file_archived"]
      },
      {
        "id": "full-composite-ssh-watch",
        "title": "Full composite run observed through SSH",
        "target_evidence_required": true,
        "requires_operator_approval": true,
        "commands": [
          "ssh <operator-approved-target> 'NOEMAFORGE_FIRST_START_TTY_STATUS_INTERVAL=10 sudo noemaforge first-start --full_composite 0 --show-candidates --show-compositions --clear-model-health --per-model-timeout 240 --total-timeout 7200'"
        ],
        "evidence": ["ssh_session_transcript", "run_transcript", "tty_status_updates", "first_start_exit_status"],
        "completion_gates": ["operator_approval_recorded", "ssh_session_transcript_archived", "full_composite_zero_recorded", "evidence_file_archived"]
      },
      {
        "id": "ssh-abort-recovery",
        "title": "Abort and GUI recovery reachable over SSH",
        "target_evidence_required": true,
        "requires_operator_approval": true,
        "commands": [
          "ssh <operator-approved-target> 'sudo noemaforge first-start abort 2>/dev/null || true'",
          "ssh <operator-approved-target> 'systemctl is-active display-manager.service || systemctl is-active gdm.service'"
        ],
        "evidence": ["ssh_abort_result", "display_manager_state_after_abort", "run_nologin_state_after_abort"],
        "completion_gates": ["operator_approval_recorded", "abort_result_recorded", "display_recovery_recorded", "evidence_file_archived"]
      },
      {
        "id": "ssh-evidence-archive",
        "title": "SSH evidence archive",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "sudo noemaforge forensics --include-first-start --include-install-validation"
        ],
        "evidence": ["forensics_bundle_path", "bundle_sha256", "redaction_manifest", "ssh_transcript_redaction_note"],
        "completion_gates": ["bundle_exists", "bundle_sha256_recorded", "ssh_transcripts_redacted", "canonical_docs_updated_after_review"]
      }
    ],
    "required_outputs": [
      "ssh_readiness_summary",
      "blocked_completion_notice",
      "target_ssh_command_manifest",
      "evidence_requirements",
      "registry_attachment",
      "docs_changelog_trace"
    ],
    "required_refs": [
      "noemaforge/configs/full-composite-ssh-readiness-policy.json",
      "noemaforge/contracts/full_composite_ssh_readiness.schema.json",
      "noemaforge/src/full_composite_ssh_readiness_runtime.py",
      "prelaunch/governance/full_composite_ssh_readiness.example.json",
      "noemaforge/configs/full-composite-target-run-readiness-policy.json",
      "noemaforge/src/full_composite_target_run_readiness_runtime.py",
      "noemaforge/docs/wiki/first-start/full-composite-real-launch-0.32.1.md",
      "noemaforge/docs/README.md",
      "noemaforge/docs/TODO.md",
      "noemaforge/docs/reference/PROJECT_CONTEXT.md",
      "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
      "noemaforge/docs/history/CHANGELOG.md"
    ]
  },
  "refs": [
    "noemaforge/configs/full-composite-ssh-readiness-policy.json",
    "noemaforge/contracts/full_composite_ssh_readiness.schema.json",
    "noemaforge/src/full_composite_ssh_readiness_runtime.py",
    "noemaforge/tests/test_full_composite_ssh_readiness_runtime.py",
    "noemaforge/tests/test_full_composite_ssh_readiness_qa.py",
    "noemaforge/tests/test_full_composite_ssh_readiness_performance.py",
    "prelaunch/governance/full_composite_ssh_readiness.example.json",
    "noemaforge/configs/full-composite-target-run-readiness-policy.json",
    "noemaforge/src/full_composite_target_run_readiness_runtime.py",
    "noemaforge/docs/wiki/first-start/full-composite-real-launch-0.32.1.md",
    "noemaforge/docs/README.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}

