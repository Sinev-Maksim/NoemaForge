{
  "apiVersion": "noemaforge.setup-default-path/v1",
  "kind": "SetupDefaultPathPolicy",
  "id": "setup-default-path-core",
  "version": "0.32.0.alpha",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "activation_state": "single_blessed_install_story",
    "required_pipeline_ref": "pipeline:firstboot-model-selection:0.31.13.alpha-patched1",
    "setup_script_ref": "setup.sh",
    "quickstart_ref": "docs/onboarding/QUICKSTART_VM.md",
    "setup_modes_ref": "docs/onboarding/SETUP_MODES.md",
    "require_trace_id": true,
    "require_registry_attachment": true,
    "require_docs_and_changelog_refs": true,
    "require_no_live_dependency": true,
    "boundary_phrase": "Setup default path boundary: The blessed onboarding path is release unpack or git clone, then root ./setup.sh in VM mode first, then host install only by explicit operator choice; Windows helpers are optional side tools and are never required for the canonical path.",
    "canonical_steps": ["release_unpack_or_git_clone", "root_setup_sh", "vm_mode_first", "explicit_host_install", "reboot_then_use"],
    "required_modes": ["vm", "host", "docker-dev", "macos-dev"],
    "forbidden_canonical_dependencies": ["powershell", ".ps1", ".cmd", "windows-only"],
    "controls": {
      "root_setup_front_door_required": true,
      "vm_mode_default_required": true,
      "vm_dry_run_selftest_required": true,
      "windows_helpers_optional_only": true,
      "host_install_explicit_only": true,
      "quickstart_vm_required": true,
      "setup_modes_required": true,
      "no_live_host_required": true
    },
    "required_boundary_refs": [
      "docs/README.md",
      "docs/TODO.md",
      "docs/backlog/ROADMAP_AND_TODO.md",
      "docs/history/CHANGELOG.md",
      "docs/reference/PROJECT_CONTEXT.md",
      "noemaforge/docs/README.md",
      "noemaforge/docs/TODO.md",
      "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
      "noemaforge/docs/history/CHANGELOG.md",
      "noemaforge/docs/reference/PROJECT_CONTEXT.md"
    ],
    "required_onboarding_refs": [
      "setup.sh",
      "docs/onboarding/QUICKSTART_VM.md",
      "docs/onboarding/SETUP_MODES.md",
      "docs/operations/OPERATOR_GUIDE.md"
    ],
    "required_example_sets": [
      "prelaunch/governance/setup_default_path.example.json"
    ]
  },
  "refs": [
    "noemaforge/configs/setup-default-path-policy.json",
    "noemaforge/contracts/setup_default_path.schema.json",
    "noemaforge/src/setup_default_path_runtime.py",
    "setup.sh",
    "docs/onboarding/QUICKSTART_VM.md",
    "docs/onboarding/SETUP_MODES.md",
    "docs/operations/OPERATOR_GUIDE.md",
    "noemaforge/tests/test_setup_default_path_runtime.py",
    "noemaforge/tests/test_setup_default_path_qa.py",
    "noemaforge/tests/test_setup_default_path_performance.py",
    "prelaunch/governance/setup_default_path.example.json",
    "docs/README.md",
    "docs/TODO.md",
    "docs/backlog/ROADMAP_AND_TODO.md",
    "docs/history/CHANGELOG.md",
    "docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/README.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/history/CHANGELOG.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md"
  ]
}

