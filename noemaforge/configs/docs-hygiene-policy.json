{
  "apiVersion": "noemaforge.docs-hygiene/v1",
  "kind": "DocsHygienePolicy",
  "id": "prelaunch-docs-hygiene",
  "version": "0.32.2",
  "status": "stable",
  "policy": {
    "approved_markdown_prefixes": [
      "docs/",
      "noemaforge/docs/",
      "helpers/",
      "prelaunch/"
    ],
    "allowed_root_markdown": ["CLAUDE.md", "README.md", "context.md"],
    "allowed_docs_root_markdown": [
      "noemaforge/docs/README.md",
      "noemaforge/docs/Manifest.md",
      "noemaforge/docs/TODO.md"
    ],
    "allowed_package_root_markdown": [],
    "legacy_root_markdown_patterns": [],
    "canonical_changelog_refs": [
      "noemaforge/docs/history/CHANGELOG.md"
    ],
    "allowed_parallel_changelog_prefixes": ["docs/i18n/", "noemaforge/docs/i18n/"],
    "forbidden_markdown_prefixes": [
      "noemaforge/docs/source_reports/",
      "noemaforge/docs/research_sources/",
      "noemaforge/docs/research/",
      "noemaforge/docs/todo/",
      "noemaforge/docs/patches/",
      "noemaforge/docs/pub\u006cic/",
      "noemaforge/docs/wiki/pub\u006cic/"
    ],
    "forbidden_active_text": [
      "BigBro\u002dBOS",
      "docs/pub\u006cic",
      "noemaforge/docs/pub\u006cic",
      "OUT\u0044ATED"
    ],
    "required_canonical_files": [
