{
  "apiVersion": "noemaforge.docs/v1",
  "kind": "StaleWikiVersionAudit",
  "id": "stale-wiki-version-audit-core",
  "version": "0.32.0.alpha",
  "status": "shadow",
  "principle": "Versioned wiki pages must be inventoried before archival so useful prose is not removed without a canonical 0.32.1 destination.",
  "policy": {
    "mode": "offline_docs_inventory_contract",
    "wiki_root": "noemaforge/docs/wiki",
    "current_release": "0.32.1",
    "stale_filename_patterns": [
      "0.31.",
      "0.30.",
      "0.29.",
      "0.28.",
      "0.27.",
      "0.26."
    ],
    "archive_without_crosswalk_allowed": false,
    "historical_filename_allowed_when_referenced": true,
    "required_next_actions": [
      "inventory_versioned_pages",
      "map_to_canonical_topic",
      "merge_unique_prose",
      "move_obsolete_source_to_trash_after_integration",
      "preserve_redirect_or_crosswalk"
    ],
    "active_todo_must_remain_open_until_moves_complete": true
  },
  "expected_report": {
    "stale_pages_may_exist": true,
    "requires_human_safe_migration_review": true,
    "must_not_claim_completion": true
  },
  "refs": [
    "noemaforge/configs/stale-wiki-version-audit.json",
    "helpers/stale_wiki_version_audit.mjs",
    "helpers/stale_wiki_version_audit.qa.test.mjs",
    "helpers/stale_wiki_version_audit.performance.test.mjs",
    "noemaforge/docs/wiki/quality/stale-wiki-version-audit.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/backlog/CURRENT_0.32.1_TODO.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}
