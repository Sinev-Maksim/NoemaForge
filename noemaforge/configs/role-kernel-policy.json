    "active_nn_manager": {
      "max_active_heavy_workers": 1,
      "allow_parallel_heavy_workers": false,
      "durable_baton_required": true,
      "sleep_wake_baton_required": true
    },
    "evolve_boundary": {
      "mutation_scope": "lab_only",
      "production_weight_mutation": false,
      "promotion_path": [
        "system.guard/scary",
        "system.guard/surgeon",
        "operator.admin/administrator"
      ]
    },
    "required_example_sets": [
      "prelaunch/governance/role_kernel.example.json"
