{
  "apiVersion": "noemaforge.role-kernel/v1",
  "kind": "RoleKernelPolicy",
  "id": "role-kernel-active-nn-core",
  "version": "0.32.2",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "activation_state": "protected_kernel",
    "require_trace_id": true,
    "require_registry_attachment": true,
    "require_policy_schema_runtime_tests": true,
    "require_docs_and_changelog_refs": true,
    "required_pipeline_ref": "pipeline:firstboot-model-selection:0.32.2",
    "persona_catalog_ref": "configs/persona-catalog.json",
    "role_catalog_ref": "configs/role-catalog.yaml",
    "default_roles": [
      {
        "id": "admin",
        "role_key": "operator.admin/administrator",
        "display_name": "Admin",
        "role_class": "lightweight_supervisor",
        "installed_by_default": true,
        "always_present": true,
        "heavy_worker": false
      },
      {
        "id": "surgeon",
        "role_key": "system.guard/surgeon",
        "display_name": "Surgeon",
        "role_class": "repair_worker",
        "installed_by_default": true,
        "always_present": false,
        "heavy_worker": true
      },
      {
        "id": "scary",
        "role_key": "system.guard/scary",
        "display_name": "Scary",
        "role_class": "lightweight_supervisor",
        "installed_by_default": true,
        "always_present": true,
        "heavy_worker": false
      },
      {
        "id": "evolver_darwin",
        "role_key": "selfdev.learning/coach",
        "display_name": "Evolver/Darwin",
        "role_class": "lab_worker",
        "installed_by_default": true,
        "always_present": false,
        "heavy_worker": true
      }
    ],
    "optional_rolepacks": [
