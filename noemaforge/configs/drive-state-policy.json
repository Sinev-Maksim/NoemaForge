{
  "apiVersion": "noemaforge.drive-state/v1",
  "kind": "DriveStatePolicy",
  "id": "drive-state-governance-core",
  "version": "0.32.2",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "require_sense_state_ref": true,
    "require_privacy_filtered_source": true,
    "require_bounded_signals": true,
    "require_clipping": true,
    "require_hysteresis": true,
    "require_cooldown": true,
    "forbid_goal_rewrite": true,
    "forbid_policy_override": true,
    "signals": [
      "pressure",
      "fatigue",
      "urgency",
      "curiosity"
    ],
    "bounds": {
      "min": 0.0,
      "max": 1.0
    },
    "hysteresis": {
      "min_delta": 0.05,
      "decay": 0.2
    },
    "cooldown_seconds": 60,
    "allowed_actions": [
      "allow",
      "slow_down",
      "ask_clarification",
      "defer",
      "rest",
      "explore"
    ],
    "required_example_sets": [
      "prelaunch/governance/drive_state.example.json"
    ]
  },
  "refs": [
    "noemaforge/configs/drive-state-policy.json",
    "noemaforge/contracts/drive_state.schema.json",
    "noemaforge/src/drive_state_runtime.py",
    "noemaforge/tests/test_drive_state_runtime.py",
    "noemaforge/tests/test_drive_state_qa.py",
    "noemaforge/tests/test_drive_state_performance.py",
    "prelaunch/governance/drive_state.example.json",
    "prelaunch/governance/sense_privacy.example.json",
    "docs/wiki/architecture/typed-control-plane-sense-critics-rfc-0.32.1.md",
    "docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md"
  ]
}

