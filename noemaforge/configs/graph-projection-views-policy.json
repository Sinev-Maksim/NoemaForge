{
  "apiVersion": "noemaforge.graph-projection-views/v1",
  "kind": "GraphProjectionViewsPolicy",
  "id": "graph-projection-views-core",
  "version": "0.32.2",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "activation_state": "graph_derived_projection_views",
    "require_trace_id": true,
    "require_registry_attachment": true,
    "require_docs_and_changelog_refs": true,
    "require_no_live_dependency": true,
    "required_pipeline_ref": "pipeline:firstboot-model-selection:0.32.1",
    "source_graph_manifest_ref": "manifests/functional/knowledge.hypergraph.yaml",
    "required_projection_types": ["wiki_markdown", "operator_summary", "task_context", "conflict_review"],
    "required_metadata_fields": ["projection_type", "source_graph_ref", "source_graph_digest", "generated_from_graph", "not_source_of_truth", "generated_at"],
    "required_notice_tokens": ["projection", "derived from graph", "not source of truth"],
    "controls": {
      "projection_not_source_of_truth": true,
      "source_graph_digest_required": true,
      "source_graph_ref_required": true,
      "manual_projection_claims_forbidden": true,
      "citations_preserve_claim_refs": true,
      "uncertainty_visible_in_operator_view": true,
      "conflicts_visible_in_review_view": true,
      "no_live_host_required": true
    },
    "boundary_phrase": "Graph projection boundary: Wiki-like pages are projections derived from graph state: every projection carries source graph refs, graph digest, generated_at, projection type, and a not-source-of-truth notice so human-readable pages never become the canonical knowledge store.",
    "required_boundary_refs": [
      "docs/README.md",
      "noemaforge/docs/README.md",
      "docs/TODO.md",
      "noemaforge/docs/TODO.md",
      "docs/reference/PROJECT_CONTEXT.md",
      "noemaforge/docs/reference/PROJECT_CONTEXT.md",
      "docs/backlog/ROADMAP_AND_TODO.md",
      "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
      "docs/history/CHANGELOG.md",
      "noemaforge/docs/history/CHANGELOG.md"
    ],
    "required_example_sets": [
      "prelaunch/governance/graph_projection_views.example.json"
    ]
  },
  "refs": [
    "noemaforge/configs/graph-projection-views-policy.json",
    "noemaforge/contracts/graph_projection_views.schema.json",
    "noemaforge/manifests/functional/knowledge.hypergraph.yaml",
    "noemaforge/src/graph_projection_views_runtime.py",
    "noemaforge/tests/test_graph_projection_views_runtime.py",
    "noemaforge/tests/test_graph_projection_views_qa.py",
    "noemaforge/tests/test_graph_projection_views_performance.py",
    "prelaunch/governance/graph_projection_views.example.json",
    "docs/README.md",
    "noemaforge/docs/README.md",
    "docs/TODO.md",
    "noemaforge/docs/TODO.md",
    "docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md",
    "docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "docs/history/CHANGELOG.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}

