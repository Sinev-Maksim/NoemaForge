{
  "apiVersion": "noemaforge.governance/v1",
  "kind": "McpA2aAdapterThreatModel",
  "id": "mcp-a2a-adapter-threat-model-core",
  "version": "0.32.0.alpha",
  "status": "shadow",
  "principle": "MCP and A2A adapters are zero-trust extension boundaries until a reviewed threat model proves a narrower capability set is safe.",
  "policy": {
    "mode": "offline_contract",
    "live_adapters_enabled_by_default": false,
    "zero_trust_adapter_manifest_required": true,
    "deny_by_default_tool_exposure": true,
    "per_adapter_capability_scopes_required": true,
    "sr_ssr_review_required": true,
    "network_access_default": "deny",
    "mutating_actions_require_approval": true,
    "secrets_inline_allowed": false,
    "audit_trail_required": true,
    "rollback_plan_required": true
  },
  "required_manifest_fields": [
    "adapter_id",
    "protocol",
    "enabled",
    "capability_scopes",
    "tool_exposure",
    "network_access",
    "mutating_actions",
    "sr_ssr_review",
    "audit_trail",
    "rollback_plan"
  ],
  "example_adapters": [
    {
      "adapter_id": "mcp.local.docs",
      "protocol": "mcp",
      "enabled": false,
      "capability_scopes": [
        "docs.read"
      ],
      "tool_exposure": "explicit_allowlist",
      "network_access": "deny",
      "mutating_actions": "deny",
      "sr_ssr_review": true,
      "audit_trail": true,
      "rollback_plan": "disable adapter and remove capability token binding",
      "expected": "allow_shadow"
    },
    {
      "adapter_id": "a2a.release-summary-peer",
      "protocol": "a2a",
      "enabled": false,
      "capability_scopes": [
        "release.summary.exchange"
      ],
      "tool_exposure": "explicit_allowlist",
      "network_access": "deny",
      "mutating_actions": "approval_required",
      "sr_ssr_review": true,
      "audit_trail": true,
      "rollback_plan": "revoke peer envelope trust and quarantine received artifacts",
      "expected": "allow_shadow"
    },
    {
      "adapter_id": "mcp.unreviewed.shell",
      "protocol": "mcp",
      "enabled": true,
      "capability_scopes": [
        "exec.run"
      ],
      "tool_exposure": "wildcard",
      "network_access": "allow",
      "mutating_actions": "allow",
      "sr_ssr_review": false,
      "audit_trail": false,
      "rollback_plan": "",
      "expected": "deny",
      "expected_failures": [
        "live_adapter_enabled",
        "wildcard_tool_exposure_denied",
        "network_access_not_denied",
        "sr_ssr_review_required"
      ]
    }
  ],
  "refs": [
    "noemaforge/configs/mcp-a2a-adapter-threat-model.json",
    "helpers/mcp_a2a_adapter_threat_model.mjs",
    "helpers/mcp_a2a_adapter_threat_model.qa.test.mjs",
    "helpers/mcp_a2a_adapter_threat_model.performance.test.mjs",
    "noemaforge/docs/wiki/governance/mcp-a2a-adapter-threat-model.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/backlog/CURRENT_0.32.1_TODO.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}
