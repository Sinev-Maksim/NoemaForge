{
  "apiVersion": "noemaforge.smarthome/v1",
  "kind": "SmartHomePrivacyEvaluationGate",
  "id": "smarthome-privacy-evaluation-gate-core",
  "version": "0.32.0.alpha",
  "status": "shadow",
  "principle": "SmartHome automation is local-first and privacy-first until target evidence proves otherwise.",
  "policy": {
    "mode": "offline_contract",
    "allowed_device_sources": [
      "trusted",
      "simulated",
      "unverified"
    ],
    "camera_policy": {
      "local_only_required": true,
      "visible_privacy_state_required": true,
      "hidden_capture_allowed": false,
      "raw_media_persistence_allowed": false
    },
    "cloud_policy": {
      "upload_default_allowed": false,
      "external_cloud_requires_operator_approval": true,
      "missing_cloud_state_is_failure": true
    },
    "automation_policy": {
      "audit_trail_required": true,
      "trace_id_required": true,
      "human_override_required": true,
      "emergency_all_automation_pause_required": true
    },
    "evaluation_policy": {
      "local_only": true,
      "target_hardware_required_for_runtime_claims": true,
      "deny_if_source_unknown": true,
      "deny_if_camera_cloud_path_present": true,
      "deny_if_emergency_pause_missing": true
    }
  },
  "example_cases": [
    {
      "name": "trusted_local_camera_with_pause",
      "device_source": "trusted",
      "camera": {
        "present": true,
        "local_only": true,
        "visible_privacy_state": true,
        "hidden_capture": false
      },
      "cloud_upload_default": false,
      "audit_trail": true,
      "trace_id": "trace-smarthome-privacy-001",
      "human_override": true,
      "emergency_all_automation_pause": true,
      "expected": "allow"
    },
    {
      "name": "simulated_sensor_without_camera",
      "device_source": "simulated",
      "camera": {
        "present": false
      },
      "cloud_upload_default": false,
      "audit_trail": true,
      "trace_id": "trace-smarthome-privacy-002",
      "human_override": true,
      "emergency_all_automation_pause": true,
      "expected": "allow"
    },
    {
      "name": "unverified_device_without_pause",
      "device_source": "unverified",
      "camera": {
        "present": false
      },
      "cloud_upload_default": false,
      "audit_trail": true,
      "trace_id": "trace-smarthome-privacy-003",
      "human_override": true,
      "emergency_all_automation_pause": false,
      "expected": "deny",
      "expected_failures": [
        "emergency_all_automation_pause_required"
      ]
    }
  ],
  "refs": [
    "noemaforge/configs/smarthome-privacy-evaluation-gate.json",
    "helpers/smarthome_privacy_evaluation_gate.mjs",
    "helpers/smarthome_privacy_evaluation_gate.qa.test.mjs",
    "helpers/smarthome_privacy_evaluation_gate.performance.test.mjs",
    "noemaforge/docs/wiki/smarthome/privacy-evaluation-gate.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/backlog/CURRENT_0.32.1_TODO.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}
