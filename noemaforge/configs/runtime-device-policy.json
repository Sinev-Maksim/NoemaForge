{
  "apiVersion": "noemaforge.runtime/v1",
  "kind": "RuntimeDevicePolicy",
  "version": "0.31.13.alpha",
  "default": "auto",
  "allowed": [
    "auto",
    "cpu",
    "gpu"
  ],
  "applies_on": "next_persona_or_model_switch",
  "readme_warning": "Changing CPU/GPU policy does not migrate an active model."
}
