  "id": "stale-wiki-exact-duplicate-plan-core",
  "version": "0.32.0.alpha",
  "status": "shadow",
  "principle": "Only byte-equivalent versioned wiki duplicates may be proposed for automatic consolidation; non-identical pages require prose review.",
  "policy": {
    "mode": "offline_docs_duplicate_plan_contract",
