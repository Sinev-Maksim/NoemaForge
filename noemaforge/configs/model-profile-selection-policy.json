{
  "apiVersion": "noemaforge.model-profile-selection/v1",
  "kind": "ModelProfileSelectionPolicy",
  "id": "model-profile-selection-core",
  "version": "0.32.2",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "activation_state": "profile_driven_model_staging",
    "required_pipeline_ref": "pipeline:firstboot-model-selection:0.32.1",
    "profile_manifest_ref": "configs/model-profiles.json",
    "runtime_ref": "src/model_profiles.py",
    "firstboot_ref": "src/firstboot_orchestrator.py",
    "setup_ref": "setup.sh",
    "require_trace_id": true,
    "require_registry_attachment": true,
    "require_docs_and_changelog_refs": true,
    "require_no_live_dependency": true,
    "boundary_phrase": "Model profile boundary: New users choose a minimal/balanced/writer/research/gpu-heavy profile; each profile declares model hints, role staging targets, resource floors and a no-auto-download staging manifest so setup and firstboot avoid manual model-file curation.",
    "required_profiles": ["minimal", "balanced", "writer", "research", "gpu-heavy"],
    "required_profile_fields": ["description", "max_active_llms", "default_runtime", "ram_gib_min", "vram_gib_min", "model_hints", "roles"],
    "required_cli_surfaces": [
      "noemaforge profiles list",
      "noemaforge profiles show",
      "noemaforge profiles recommend",
      "noemaforge profiles plan",
      "setup.sh --model-profile",
      "noemaforge first-start --model-profile"
    ],
    "required_runtime_controls": [
      "max_active_llms_is_one",
      "no_auto_download",
      "profile_manifest_written",
      "setup_flag_supported",
      "firstboot_flag_supported"
    ],
    "required_boundary_refs": [
      "docs/README.md",
      "docs/TODO.md",
      "docs/backlog/ROADMAP_AND_TODO.md",
      "docs/history/CHANGELOG.md",
      "docs/reference/PROJECT_CONTEXT.md",
      "noemaforge/docs/README.md",
      "noemaforge/docs/TODO.md",
      "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
      "noemaforge/docs/history/CHANGELOG.md",
      "noemaforge/docs/reference/PROJECT_CONTEXT.md"
    ],
    "required_example_sets": [
      "prelaunch/governance/model_profile_selection.example.json"
    ]
  },
  "refs": [
    "noemaforge/configs/model-profile-selection-policy.json",
    "noemaforge/contracts/model_profile_selection.schema.json",
    "noemaforge/configs/model-profiles.json",
    "noemaforge/configs/model-profiles.yaml",
    "noemaforge/src/model_profiles.py",
    "noemaforge/src/model_profile_selection_runtime.py",
    "noemaforge/src/firstboot_orchestrator.py",
    "noemaforge/tools/prep/noemaforge-first-launch.sh",
    "noemaforge/tools/prep/noemaforge-firstboot-from-share.sh",
    "setup.sh",
    "noemaforge/bin/noemaforge",
    "noemaforge/tests/test_model_profile_selection_runtime.py",
    "noemaforge/tests/test_model_profile_selection_qa.py",
    "noemaforge/tests/test_model_profile_selection_performance.py",
    "prelaunch/governance/model_profile_selection.example.json",
    "docs/README.md",
    "docs/TODO.md",
    "docs/backlog/ROADMAP_AND_TODO.md",
    "docs/history/CHANGELOG.md",
    "docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/README.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/history/CHANGELOG.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md"
  ]
}

