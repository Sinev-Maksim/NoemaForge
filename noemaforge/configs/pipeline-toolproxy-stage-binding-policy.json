{
  "apiVersion": "noemaforge.pipeline-toolproxy-stage-binding/v1",
  "kind": "PipelineToolProxyStageBindingPolicy",
  "id": "pipeline-toolproxy-stage-binding-core",
  "version": "0.32.2",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "required_tool_policy_ref": "tool-policy:tool-policy-main:0.32.2",
    "capability_schema_ref": "contracts/capability_token.schema.json",
    "require_capability_token": true,
    "require_stage_scope": true,
    "require_run_manifest_binding": true,
    "require_context_packet_binding": true,
    "require_policy_schema_runtime_tests": true,
    "require_docs_and_changelog_refs": true,
    "require_registry_attachment": true,
    "controls": {
      "deny_by_default": true,
      "stage_scoped_tokens": true,
      "network_default_deny": true,
      "mutating_actions_require_approval": true,
      "exec_actions_require_sandbox": true,
      "review_stages_may_record_roadmap": true,
      "public_mwp_is_readmostly": true
    },
    "required_binding_fields": [
      "policy_ref",
      "capability_schema_ref",
      "pipeline_id",
      "stage",
      "scope",
      "capability_token_required",
      "approval_required",
      "sandbox_required",
      "network_allowed",
      "allowed_actions",
      "mutating_actions",
      "sandboxed_actions",
      "blocked_actions"
    ],
    "required_runtime_tokens": [
      "TOOLPROXY_POLICY_REF",
      "build_toolproxy_stage_binding",
      "toolproxy_stage_binding",
      "toolproxy_stage_bindings",
      "toolproxy-policy"
    ],
    "required_docs": [
      "noemaforge/docs/README.md",
      "noemaforge/docs/TODO.md",
      "noemaforge/docs/reference/PROJECT_CONTEXT.md",
      "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
      "noemaforge/docs/wiki/pipelines/wiki-incremental-patch-pipeline.md",
      "noemaforge/docs/history/CHANGELOG.md"
    ],
    "required_example_sets": [
      "prelaunch/governance/pipeline_toolproxy_stage_binding.example.json"
    ]
  }
}

