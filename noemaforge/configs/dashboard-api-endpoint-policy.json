{
  "apiVersion": "noemaforge.dashboard-api-endpoint/v1",
  "kind": "DashboardApiEndpointPolicy",
  "id": "dashboard-api-endpoint-core",
  "version": "0.32.2",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "local_first_default": true,
    "require_registry_attachment": true,
    "require_docs_and_changelog_refs": true,
    "endpoint": "/api/dashboard",
    "alias_endpoint": "/api/dashboard/state",
    "compatibility_endpoint": "/api/gui/state",
    "required_api_paths": [
      "/api/dashboard",
      "/api/dashboard/state",
      "/api/gui/state"
    ],
    "required_runtime_tokens": [
      "def dashboard_api",
      "dashboard_backend",
      "dashboard_state",
      "conversation_history",
      "pipeline_catalog_api",
      "dashboard-api-endpoint-core"
    ],
    "required_frontend_tokens": [
      "loadDashboardBackendState",
      "/api/dashboard",
      "/api/gui/state",
      "renderConversation",
      "renderArtifacts"
    ],
    "required_sections": [
      "dashboard",
      "conversation",
      "tasks",
      "jobs",
      "persona",
      "pipelines",
      "telemetry"
    ],
    "required_docs": [
      "noemaforge/docs/README.md",
      "noemaforge/docs/TODO.md",
      "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
      "noemaforge/docs/reference/PROJECT_CONTEXT.md",
      "noemaforge/docs/history/CHANGELOG.md"
    ]
  },
  "refs": [
    "configs/dashboard-api-endpoint-policy.json",
    "contracts/dashboard_api_endpoint.schema.json",
    "src/dashboard_api_endpoint_runtime.py",
    "src/admin_gui_server.py",
    "templates/pipeline-dashboard/app.js",
    "tests/test_dashboard_api_endpoint_runtime.py",
    "tests/test_dashboard_api_endpoint_qa.py",
    "tests/test_dashboard_api_endpoint_performance.py",
    "prelaunch/governance/dashboard_api_endpoint.example.json",
    "docs/README.md",
    "docs/TODO.md",
    "docs/backlog/ROADMAP_AND_TODO.md",
    "docs/reference/PROJECT_CONTEXT.md",
    "docs/history/CHANGELOG.md"
  ]
}
