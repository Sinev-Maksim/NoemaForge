{
  "apiVersion": "noemaforge.setup-front-door/v1",
  "kind": "SetupFrontDoorPolicy",
  "id": "setup-front-door-core",
  "version": "0.32.1",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "activation_state": "root_setup_wraps_bootstrap_firstboot_progress",
    "required_pipeline_ref": "pipeline:firstboot-model-selection:0.32.1",
    "setup_script_ref": "setup.sh",
    "installer_ref": "install_noemaforge_mvp.sh",
    "firstboot_orchestrator_ref": "src/firstboot_orchestrator.py",
    "require_trace_id": true,
    "require_registry_attachment": true,
    "require_docs_and_changelog_refs": true,
    "require_no_live_dependency": true,
    "boundary_phrase": "Setup front door boundary: Root setup.sh is the single setup front door, supports vm/host/docker-dev plus install-root/data-root/model-profile/with-share/offline-after-setup flags, and emits bootstrap/firstboot progress phases so newcomers do not discover helper scripts manually.",
    "required_modes": ["vm", "host", "docker-dev"],
    "optional_modes": ["macos-dev"],
    "required_flags": ["--mode", "--install-root", "--data-root", "--model-profile", "--with-share", "--offline-after-setup"],
    "required_phase_markers": [
      "seed_copy",
      "host_preflight",
      "vault_scan",
      "inbox_normalize",
      "candidate_staging",
      "role_staffing",
      "epoch_apply",
      "reboot_pending"
    ],
    "required_wrapper_markers": ["bootstrap", "firstboot_orchestrator", "progress_output"],
    "controls": {
      "root_setup_exists": true,
      "required_modes_supported": true,
      "required_flags_supported": true,
      "bootstrap_firstboot_progress_wrapped": true,
      "phase_progress_output_required": true,
      "non_dry_run_requires_root": true,
      "installer_one_way_delegation": true,
      "no_live_host_required": true
    },
    "required_boundary_refs": [
      "docs/README.md",
      "docs/TODO.md",
      "docs/backlog/ROADMAP_AND_TODO.md",
      "docs/history/CHANGELOG.md",
      "docs/reference/PROJECT_CONTEXT.md",
      "noemaforge/docs/README.md",
      "noemaforge/docs/TODO.md",
      "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
      "noemaforge/docs/history/CHANGELOG.md",
      "noemaforge/docs/reference/PROJECT_CONTEXT.md"
    ],
    "required_runtime_refs": [
      "setup.sh",
      "install_noemaforge_mvp.sh",
      "src/firstboot_orchestrator.py",
      "src/firstboot_status.py",
      "src/firstboot_eval.py"
    ],
    "required_example_sets": [
      "prelaunch/governance/setup_front_door.example.json"
    ]
  },
  "refs": [
    "noemaforge/configs/setup-front-door-policy.json",
    "noemaforge/contracts/setup_front_door.schema.json",
    "noemaforge/src/setup_front_door_runtime.py",
    "setup.sh",
    "install_noemaforge_mvp.sh",
    "noemaforge/src/firstboot_orchestrator.py",
    "noemaforge/src/firstboot_status.py",
    "noemaforge/src/firstboot_eval.py",
    "noemaforge/tests/test_setup_front_door_runtime.py",
    "noemaforge/tests/test_setup_front_door_qa.py",
    "noemaforge/tests/test_setup_front_door_performance.py",
    "prelaunch/governance/setup_front_door.example.json",
    "docs/README.md",
    "docs/TODO.md",
    "docs/backlog/ROADMAP_AND_TODO.md",
    "docs/history/CHANGELOG.md",
    "docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/README.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/history/CHANGELOG.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md"
  ]
}

