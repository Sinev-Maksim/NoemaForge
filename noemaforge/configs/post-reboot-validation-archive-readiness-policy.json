{
  "apiVersion": "noemaforge.post-reboot-validation-archive-readiness/v1",
  "kind": "PostRebootValidationArchiveReadinessPolicy",
  "id": "post-reboot-validation-archive-readiness-core",
  "version": "0.32.0.alpha",
  "status": "shadow",
  "policy": {
    "mode": "offline_contract",
    "activation_state": "patched10_post_reboot_validation_archive_readiness",
    "completion_state": "blocked_until_target_post_reboot_archive_evidence",
    "require_registry_attachment": true,
    "require_docs_and_changelog_refs": true,
    "require_no_live_execution": true,
    "blocked_todo_refs": [
      "Complete post-reboot NoemaForge validation and archive logs as wiki patch."
    ],
    "required_safety_controls": {
      "no_auto_live_execution": true,
      "target_machine_required": true,
      "operator_approval_required": true,
      "post_reboot_evidence_required": true,
      "service_health_evidence_required": true,
      "forensics_archive_required": true,
      "wiki_patch_bundle_required": true,
      "local_validator_has_no_subprocess": true
    },
    "required_checks": [
      {
        "id": "post-reboot-baseline",
        "title": "Post-reboot system baseline",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "systemctl is-system-running || true",
          "systemctl --failed --no-pager",
          "hostnamectl",
          "cat /proc/sys/kernel/random/boot_id"
        ],
        "evidence": ["post_reboot_boot_id", "system_running_state", "failed_units", "host_baseline"],
        "completion_gates": ["boot_id_recorded", "system_state_recorded", "failed_units_recorded", "host_baseline_recorded", "evidence_file_archived"]
      },
      {
        "id": "runtime-service-health",
        "title": "Runtime service health",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "systemctl status noemaforge-llm-gateway.service --no-pager -l",
          "systemctl status noemaforge-llama@main.service --no-pager -l || true",
          "systemctl status display-manager.service --no-pager -l || systemctl status gdm.service --no-pager -l",
          "ss -ltnp | grep -E 'noemaforge|llama|8080|8000' || true"
        ],
        "evidence": ["gateway_service_state", "main_backend_service_state", "display_manager_state", "socket_state"],
        "completion_gates": ["service_states_recorded", "display_state_recorded", "socket_state_recorded", "evidence_file_archived"]
      },
      {
        "id": "target-smoke-transcript",
        "title": "Target smoke transcript",
        "target_evidence_required": true,
        "requires_operator_approval": true,
        "commands": [
          "sudo noemaforge trixie-preflight --json",
          "noemaforge toolproxy smoke --live-llm || true",
          "noemaforge selftest run --suite live --include-live"
        ],
        "evidence": ["trixie_preflight_json", "toolproxy_live_smoke_transcript", "live_selftest_transcript", "operator_approval_record"],
        "completion_gates": ["operator_approval_recorded", "preflight_json_archived", "smoke_transcripts_archived", "evidence_file_archived"]
      },
      {
        "id": "forensics-log-archive",
        "title": "Forensics and journal archive",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "sudo noemaforge forensics --include-first-start --include-install-validation",
          "journalctl -b --no-pager"
        ],
        "evidence": ["forensics_bundle_path", "journal_bundle_path", "bundle_sha256", "redaction_manifest"],
        "completion_gates": ["bundle_exists", "journal_bundle_exists", "bundle_sha256_recorded", "secrets_redacted", "evidence_file_archived"]
      },
      {
        "id": "wiki-patch-bundle",
        "title": "Wiki patch bundle",
        "target_evidence_required": true,
        "requires_operator_approval": false,
        "commands": [
          "noemaforge wiki-patch create --from-evidence <target-evidence-bundle>"
        ],
        "evidence": ["wiki_patch_bundle_path", "wiki_patch_manifest", "target_evidence_refs", "operator_review_note"],
        "completion_gates": ["wiki_patch_manifest_exists", "target_evidence_refs_recorded", "operator_review_recorded", "canonical_docs_updated_after_review"]
      }
    ],
    "required_outputs": [
      "post_reboot_archive_summary",
      "blocked_completion_notice",
      "target_validation_command_manifest",
      "evidence_requirements",
      "wiki_patch_requirements",
      "registry_attachment",
      "docs_changelog_trace"
    ],
    "required_refs": [
      "noemaforge/configs/post-reboot-validation-archive-readiness-policy.json",
      "noemaforge/contracts/post_reboot_validation_archive_readiness.schema.json",
      "noemaforge/src/post_reboot_validation_archive_readiness_runtime.py",
      "prelaunch/governance/post_reboot_validation_archive_readiness.example.json",
      "noemaforge/configs/target-live-validation-readiness-policy.json",
      "noemaforge/configs/share-automount-reboot-readiness-policy.json",
      "noemaforge/src/wiki_patch_runtime.py",
      "noemaforge/src/target_live_validation_readiness_runtime.py",
      "noemaforge/docs/wiki/operations/recovery-stability-trixie.md",
      "noemaforge/docs/wiki/prelaunch/prelaunch-tooling.md",
      "noemaforge/docs/README.md",
      "noemaforge/docs/TODO.md",
      "noemaforge/docs/reference/PROJECT_CONTEXT.md",
      "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
      "noemaforge/docs/history/CHANGELOG.md"
    ]
  },
  "refs": [
    "noemaforge/configs/post-reboot-validation-archive-readiness-policy.json",
    "noemaforge/contracts/post_reboot_validation_archive_readiness.schema.json",
    "noemaforge/src/post_reboot_validation_archive_readiness_runtime.py",
    "noemaforge/tests/test_post_reboot_validation_archive_readiness_runtime.py",
    "noemaforge/tests/test_post_reboot_validation_archive_readiness_qa.py",
    "noemaforge/tests/test_post_reboot_validation_archive_readiness_performance.py",
    "prelaunch/governance/post_reboot_validation_archive_readiness.example.json",
    "noemaforge/configs/target-live-validation-readiness-policy.json",
    "noemaforge/configs/share-automount-reboot-readiness-policy.json",
    "noemaforge/src/wiki_patch_runtime.py",
    "noemaforge/src/target_live_validation_readiness_runtime.py",
    "noemaforge/docs/wiki/operations/recovery-stability-trixie.md",
    "noemaforge/docs/wiki/prelaunch/prelaunch-tooling.md",
    "noemaforge/docs/README.md",
    "noemaforge/docs/TODO.md",
    "noemaforge/docs/reference/PROJECT_CONTEXT.md",
    "noemaforge/docs/backlog/ROADMAP_AND_TODO.md",
    "noemaforge/docs/history/CHANGELOG.md"
  ]
}

