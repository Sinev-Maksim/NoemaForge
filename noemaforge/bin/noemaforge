cmd_dashboard() {
  if [[ $# -eq 0 ]]; then
    exec "$ROOT/tools/prep/noemaforge-dashboard.sh" path --root "$ROOT"
  fi
  exec "$ROOT/tools/prep/noemaforge-dashboard.sh" "$@" --root "$ROOT"
}


_exec_helper() {
  local helper="$1"; shift
  if [[ -x "/usr/local/sbin/$helper" ]]; then
    exec "/usr/local/sbin/$helper" "$@"
  fi
  if [[ -x "$ROOT/../helpers/$helper" ]]; then
    exec "$ROOT/../helpers/$helper" "$@"
  fi
  if [[ -x "$ROOT/helpers/$helper" ]]; then
    exec "$ROOT/helpers/$helper" "$@"
  fi
  fail "Missing helper: $helper. Try installed mode or run: ./setup.sh --mode docker-dev --dry-run"
}

cmd_stop() {
  require_root
  _exec_helper noemaforge-stop "$@"
}

cmd_reboot_safe() {
  require_root
  _exec_helper noemaforge-reboot-safe "$@"
}

cmd_shutdown_safe() {
  require_root
  _exec_helper noemaforge-reboot-safe --shutdown "$@"
}

cmd_vault_path() {
  printf '/mnt/noemaforge-share/noemaforge-lab/data/Vault\n'
}

cmd_vault_status_simple() {
  echo "=== NOEMAFORGE_SHARE mount ==="
  findmnt /mnt/noemaforge-share || true
  echo
  echo "=== Vault ==="
  ls -lah /mnt/noemaforge-share/noemaforge-lab/data/Vault 2>/dev/null | sed -n '1,80p' || true
  echo
  echo "=== dmesg NTFS/errors, filtered ==="
  dmesg -T 2>/dev/null | grep -Eiv 'Modules linked in' | grep -Ei 'sda6|ntfs|dirty|MFT|I/O error|Buffer I/O|remount|read-only' | tail -80 || true
}

cmd_vault_mount_ro() {
  require_root
  exec /usr/local/sbin/noemaforge-vault-mount-ro "$@"
}

cmd_model_advisor() {
  _exec_helper noemaforge-model-advisor "$@"
}

cmd="${1:-}"
[[ -n "$cmd" ]] || { usage; exit 2; }
shift || true
case "$cmd" in
  prepare-gui|prepare|gui-prepare) cmd_prepare_gui "$@" ;;
  first-start|firststart|start-first) cmd_first_start "$@" ;;
  emergency-recover|recover-gui|gui-recover) require_root; "$ROOT/tools/prep/noemaforge-gui-recover-minimal.sh" --reason manual-emergency-recover ;;
  status) cmd_status "$@" ;;
  version|--version) cmd_version "$@" ;;
  guide|method|manual) cmd_guide "$@" ;;
  help|-h|--help|commands|\?) usage ;;
  next|what-next) cmd_next "$@" ;;
  chat|talk) cmd_chat "$@" ;;
  interpret|cmd-interpret|command|commands-interpret) cmd_interpret "$@" ;;
  monitor|mon|watch) cmd_monitor "$@" ;;
  tasks|task) cmd_tasks "$@" ;;
  admin|administrator|operator-admin) cmd_admin "$@" ;;
  dev-team|devteam|development-team) cmd_dev_team "$@" ;;
  model-evolution|evolve-model|model-evolve|evolution-model) cmd_model_evolution "$@" ;;
  model-selection|select-model|model-select|optimize-model|model-optimization) cmd_model_selection "$@" ;;
  member|team-member|member-cell|cell) cmd_member "$@" ;;
  qa|code-qa|quality|review-code) cmd_qa "$@" ;;
  pipeline|pipelines) cmd_pipeline "$@" ;;
  schema|schemas) cmd_schema "$@" ;;
  persona|personas|roles-persona) cmd_persona "$@" ;;
  selftest|self-test|tests|telemetry-tests|testbench) cmd_selftest "$@" ;;
  wiki-patch|wikipatch|wiki_patch|wiki-delta) cmd_wiki_patch "$@" ;;
  profiles|model-profiles|profile) cmd_profiles "$@" ;;
  normalize-models|model-normalize|canonical-models) cmd_normalize_models "$@" ;;
  eval|role-eval|evaluate) cmd_eval "$@" ;;
  toolproxy) cmd_toolproxy_diag "$@" ;;
  trixie-preflight|launcher-preflight) cmd_trixie_preflight "$@" ;;
  forensics|support-bundle|diagnostic-bundle) cmd_forensics "$@" ;;
  firstboot-archive|archive-firstboot-baseline) cmd_firstboot_archive "$@" ;;
  forensic-bundle|forensics|support-bundle) cmd_forensic_bundle "$@" ;;
  mvp-smoke|public-smoke|mwp-smoke) cmd_mvp_smoke "$@" ;;
  first-run|firstrun|first-run-audit|first-run-check|run-first-run) cmd_first_run_audit "$@" ;;
  version-audit|release-audit|metadata-audit) cmd_version_audit "$@" ;;
  consistency-audit|release-consistency|policy-audit|wiki-todo-audit) cmd_consistency_audit "$@" ;;
  av-readiness|av-diagnose|media-readiness|audio-video-readiness) cmd_av_readiness "$@" ;;
  multimodal|media|media-models|mm) cmd_multimodal "$@" ;;
  persona-gui|personas-gui|gui-personas) cmd_persona_gui_status "$@" ;;
  dashboard|console|pipeline-dashboard) cmd_dashboard "$@" ;;
  schema|schemas) cmd_schema "$@" ;;
  boot-mode|bootmode|autostart-mode) cmd_boot_mode "$@" ;;
  autostart-safe|safe-autostart) cmd_autostart_safe "$@" ;;
  models|model-list) cmd_models "$@" ;;
  inventory|model-inventory) cmd_inventory "$@" ;;
  vault) cmd_vault "$@" ;;
  datasets|dataset) cmd_datasets "$@" ;;
  eval-packs|eval-pack) cmd_eval_packs "$@" ;;
  roles|role-catalog) cmd_roles "$@" ;;
  tournament|role-tournament) cmd_tournament "$@" ;;
  runtime-safety|runtime|safety) cmd_runtime_safety "$@" ;;
  logs|log) cmd_logs "$@" ;;
  headless) cmd_headless "$@" ;;
  doctor|preflight) cmd_doctor "$@" ;;
  first-run-wizard|wizard|guided-start|mvp-wizard) cmd_first_run_wizard "$@" ;;
  fix-perms|repair-perms|permissions) cmd_fix_perms "$@" ;;

  stop|pause) cmd_stop "$@" ;;
  reboot-safe) cmd_reboot_safe "$@" ;;
  shutdown-safe) cmd_shutdown_safe "$@" ;;
  vault-path) cmd_vault_path "$@" ;;
  vault-status) cmd_vault_status_simple "$@" ;;
  vault-mount-ro) cmd_vault_mount_ro "$@" ;;
  recommend-model|quant-advisor|model-advice|quantization-advisor) cmd_model_advisor "$@" ;;

  safe-start|safe-startup|start-safe|start|up) cmd_safe_start "$@" ;;
  smoke|smoke-test|test) cmd_smoke "$@" ;;
  manager|backend-manager) cmd_manager "$@" ;;
  llm-stop|stop-llm|service-stop|services-stop|noemaforge-service-stop) cmd_stop "$@" ;;
