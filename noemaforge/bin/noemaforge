  [[ $# -ge 1 ]] || { "$HEADLESS" status; return 0; }
  case "$1" in on|off) require_root ;; esac
  exec "$HEADLESS" "$@"
}

cmd_doctor() {
  if [[ "${1:-}" == "--legacy" ]]; then
    shift || true
    local out="/workspace/outbox/bootreports/noemaforge-cli-preflight.json"
    if [[ -f "$ROOT/bootstrap/noemaforge-host-preflight.py" ]]; then
      python3 "$ROOT/bootstrap/noemaforge-host-preflight.py" --seed "$ROOT" --out "$out" || true
      cat "$out" 2>/dev/null || true
    else
      cmd_status --legacy
    fi
    return 0
  fi
  NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/noemaforge_status.py" "$@"
}

