  gui|gui-command) cmd_gui_group "$@" ;;
  gui-status|status-gui) cmd_gui_status "$@" ;;
  gui-diagnose|gui-diagnosis|diagnose-gui) cmd_gui_diagnose "$@" ;;
  gui_start|gui-start|start-gui) cmd_gui_start "$@" ;;
