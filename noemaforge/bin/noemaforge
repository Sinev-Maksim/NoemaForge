cmd_llm_stop() {
  require_root
  local parsed mode args=()
  mapfile -t parsed < <(split_mode_args "$@")
  mode="${parsed[0]}"; args=("${parsed[@]:1}")
  require_op noemaforge-op-llm-stop.sh
  case "$mode" in
    direct) exec "$OP_DIR/noemaforge-op-llm-stop.sh" "${args[@]}" ;;
    wait) run_transient __llm-stop noemaforge-llm-stop "NoemaForge LLM stop" wait "${args[@]}" ;;
    async) run_transient __llm-stop noemaforge-llm-stop "NoemaForge LLM stop" async "${args[@]}" ;;
  esac
}


cmd_guide() {
  cat <<'EOF'
NoemaForge launch method
=====================

Current target: make NoemaForge fully operational without repeating destructive first-start.

0. Keep unsafe auto-managers disabled until runtime-safety is clean:
   sudo noemaforge manager disable

1. Start the safe core:
   sudo noemaforge safe-start --wait

2. Verify local LLM path:
   noemaforge smoke

3. Preview and test the automatic backend manager once, guarded by runtime-safety
   and the runtime_desired_count=1 invariant:
   sudo noemaforge manager reconcile --plan
   sudo noemaforge manager reconcile
   noemaforge smoke

4. Only if reconcile + smoke are clean, enable timers in conservative mode:
   sudo noemaforge manager enable

5. Continue role-aware evaluation later:
   sudo noemaforge tournament run --all-roles
   noemaforge tournament results

Rules:
  - gui-rescue preserves LLM by default; use --stop-llm only when you really need to free GPU/RAM.
  - service-stop/llm-stop are emergency stop commands and are lock-protected.
  - top_k=8 is per role, not global.
  - sharded GGUF may launch only from 00001-of-N; 00002+ are blocked by runtime-safety.
  - runtime_desired_count defaults to 1: one active LLM backend at a time.
  - TODO: parallel model runtime requires explicit scheduler/RAM/VRAM guards.

Useful commands:
  noemaforge next
  noemaforge status [--json|--strict|--legacy]
  noemaforge vault-path
  noemaforge vault-status
  sudo noemaforge vault-mount-ro
  noemaforge smoke
  sudo noemaforge runtime-safety check
  sudo noemaforge manager status

UX layer:
  noemaforge chat --role admin
  noemaforge interpret "sudo noemaforge manager status; systemctl --failed --no-pager"
  noemaforge monitor
  noemaforge tasks list
  noemaforge eval run --role system.guard/sr
  noemaforge toolproxy diag --test-llm
EOF
}

cmd_next() {
  echo "=== NoemaForge next-step advisor ==="
  local failed_count
  failed_count="$(systemctl --failed --no-legend 2>/dev/null | wc -l | tr -d ' ')"
  if [[ "$failed_count" != "0" ]]; then
    echo "Failed units detected. Next: systemctl --failed --no-pager"
    systemctl --failed --no-pager || true
    return 0
  fi

  if [[ ! -S /run/noemaforge/llm/backends/main.sock ]]; then
    echo "Main backend socket is missing. Next: sudo noemaforge safe-start --wait"
    echo "Then: noemaforge smoke"
    return 0
  fi

  if [[ ! -S /run/noemaforge/llm/gateway.sock ]]; then
    echo "Gateway socket is missing. Next: sudo systemctl start noemaforge-llm-gateway.service"
    echo "Then: noemaforge smoke"
    return 0
  fi

  if noemaforge smoke --json >/tmp/noemaforge-next-smoke.json 2>/tmp/noemaforge-next-smoke.err; then
    echo "Safe core smoke passed."
    echo "Next: sudo noemaforge manager reconcile"
    echo "Then: noemaforge smoke"
    echo "If still clean: sudo noemaforge manager enable"
    return 0
  fi

  echo "Sockets exist but smoke failed. Next: noemaforge smoke"
  echo "Smoke stderr:"
  cat /tmp/noemaforge-next-smoke.err 2>/dev/null || true
}

