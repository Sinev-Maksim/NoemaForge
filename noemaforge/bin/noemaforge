cmd_toolproxy_diag() {
  local action="${1:-diag}"
  case "$action" in
    diag|diagnose|status)
      shift || true
      NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/noemaforge_toolproxy_diag.py" "$@"
      ;;
    test|test-llm)
      shift || true
      NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/noemaforge_toolproxy_diag.py" --test-llm "$@"
      ;;
    *) NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/noemaforge_toolproxy_diag.py" "$@" ;;
  esac
}


cmd_gui_diagnose() {
  NOEMAFORGE_ROOT="$ROOT" exec "$ROOT/tools/prep/noemaforge-gui-diagnose.sh" "$@"
}

cmd_gui_start() {
  NOEMAFORGE_ROOT="$ROOT" exec "$ROOT/tools/prep/noemaforge-gui-start.sh" "$@"
}

cmd_gui_group() {
  local action="${1:-help}"
  case "$action" in
    start|gui-start|gui_start) shift || true; cmd_gui_start "$@" ;;
    status|gui-status) shift || true; cmd_gui_status "$@" ;;
    diagnose|diagnosis|diag) shift || true; cmd_gui_diagnose "$@" ;;
    rescue|gui-rescue|gui_rescue|rescue-gui|rescue_gui) shift || true; cmd_gui_rescue "$@" ;;
    -h|--help|help|"?")
      cat <<'EOF'
Usage:
  noemaforge gui start [--wait] [--restart] [--dry-run]
  noemaforge gui status
  noemaforge gui diagnose [--json]
  noemaforge gui rescue [--wait|--direct] [--stop-llm]
  noemaforge gui console [start|status|stop|serve]
  noemaforge gui admin [start|status|stop|serve]

GUI start starts Debian GUI through GDM/display-manager and never starts NoemaForge LLM.
GUI console/admin starts only the local Admin GUI dashboard/API and never starts NoemaForge LLM.
GUI rescue is a recovery action and may restart display-manager after NVIDIA preflight.
EOF
      ;;
    console|dashboard|admin|admin-console)
      shift || true
      if [[ $# -eq 0 ]]; then
        cmd_dashboard start
      else
        cmd_dashboard "$@"
      fi
      ;;
    *) printf '[noemaforge][ERROR] unknown gui action: %s\n' "$action" >&2; exit 2 ;;
  esac
}

