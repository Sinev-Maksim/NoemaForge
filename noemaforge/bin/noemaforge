cmd_roles() {
  local catalog="$ROOT/configs/role-catalog.yaml"
  [[ -r "$catalog" ]] || fail "Role catalog missing: $catalog"
  echo "=== NoemaForge role catalog ==="
  echo "Rule: top_k is per role, not global. Default top_k_per_role=8."
  /usr/bin/python3 - "$catalog" <<'PYROLES'
import sys, yaml
obj=yaml.safe_load(open(sys.argv[1], encoding='utf-8')) or {}
roles=obj.get('roles') or {}
print(f"roles: {len(roles)}")
for k,v in sorted(roles.items()):
    print(f"- {k}: top_k={v.get('top_k', (obj.get('selection') or {}).get('top_k_per_role', 8))} eval_pack={v.get('eval_pack','auto')} required={','.join(v.get('required_capabilities') or [])}")
PYROLES
  local matrix="/var/lib/noemaforge/bootstrap/role-eligibility-matrix.json"
  if [[ -r "$matrix" ]] && command -v jq >/dev/null 2>&1; then
    echo
    echo "=== role eligibility summary ==="
    jq -r '.roles | to_entries[] | "\(.key): eligible=\(.value.eligible) runnable_now=\(.value.runnable_now) runtime_missing=\(.value.runtime_missing) runner_not_implemented=\(.value.runner_not_implemented)"' "$matrix" | sort
  fi
}


cmd_runtime_safety() {
  local action="${1:-check}"
  case "$action" in
    check|scan)
      require_root
      shift || true
      NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/runtime_safety.py" check "$@"
      cmd_fix_perms >/dev/null 2>&1 || true
      ;;
    repair|guard|fix)
      require_root
      shift || true
      NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/runtime_safety.py" repair "$@"
      cmd_fix_perms >/dev/null 2>&1 || true
      ;;
    smoke-main|smoke)
      shift || true
      NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/runtime_safety.py" smoke-main "$@"
      ;;
    -h|--help|help)
      cat <<'EOF'
Usage:
  sudo noemaforge runtime-safety check
  sudo noemaforge runtime-safety repair
  noemaforge runtime-safety smoke-main

Purpose:
  Block/repair ModelStore runtime hazards such as noemaforge-llama@...00005-of-00005.
  Sharded GGUF models may only be launched through 00001-of-N or a logical modelstore dir.
EOF
      ;;
    *) fail "unknown runtime-safety action: $action" ;;
  esac
}

cmd_tournament() {
  local action="${1:-results}"
  case "$action" in
    run)
      require_root
      shift || true
      local args=(run --runtime-mode run)
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --all-roles) shift ;;
          --role) args+=(--role "$2"); shift 2 ;;
          --probe) args=(run --runtime-mode probe); shift ;;
          *) args+=("$1"); shift ;;
        esac
      done
      NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/role_tournament.py" "${args[@]}"
      cmd_fix_perms >/dev/null 2>&1 || true
      ;;
    eligibility)
      shift || true
      NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/role_tournament.py" eligibility "$@"
      ;;
    results|show)
      local report="/var/lib/noemaforge/bootstrap/role-tournament-results.json"
      [[ -r "$report" ]] || fail "Tournament results missing. Run: sudo noemaforge tournament run --all-roles"
      if command -v jq >/dev/null 2>&1; then
        jq '{updated_at, principle, inventory_summary, roles: (.roles | with_entries(.value={selected_count:.value.selected_count, top_k:.value.top_k, selected:[.value.selected[]? | {model_id, score, pass_rate, json_parse_rate, avg_latency_ms}]}))}' "$report"
      else
        cat "$report"
      fi
      ;;
    -h|--help|help)
      cat <<'EOF'
Usage:
  sudo noemaforge tournament run --all-roles
  sudo noemaforge tournament run --role dev.work/dev
  sudo noemaforge tournament run --probe
  noemaforge tournament results
EOF
      ;;
    *) fail "unknown tournament action: $action" ;;
  esac
}



