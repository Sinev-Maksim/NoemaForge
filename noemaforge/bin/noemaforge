cmd_inventory() {
  local action="${1:-show}"
  case "$action" in
    scan|refresh)
      require_root
      shift || true
      NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/vault_inventory.py" scan "$@"
      cmd_fix_perms >/dev/null 2>&1 || true
      ;;
    show|list|summary)
      local report="/var/lib/noemaforge/bootstrap/model-inventory.json"
      [[ -r "$report" ]] || fail "Model inventory missing. Run: sudo noemaforge inventory scan"
      if command -v jq >/dev/null 2>&1; then
        echo "=== model inventory summary ==="
        jq '.summary + {vault_root, legacy_vault_root, updated_at}' "$report"
        echo
        echo "=== by capability ==="
        jq -r '.summary.by_capability // {} | to_entries[] | "\(.key): \(.value)"' "$report" | sort || true
      else
        cat "$report"
      fi
      ;;
    -h|--help|help)
      cat <<'EOF'
Usage:
  sudo noemaforge inventory scan [--share-root PATH] [--vault-root PATH]
  noemaforge inventory
EOF
      ;;
    *) fail "unknown inventory action: $action" ;;
  esac
}

cmd_vault() {
  local action="${1:-status}"
  case "$action" in
    scan|status)
      require_root
      shift || true
      NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/vault_inventory.py" scan "$@"
      cmd_fix_perms >/dev/null 2>&1 || true
      ;;
    plan)
      require_root
      shift || true
      NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/vault_reorg.py" plan "$@"
      cmd_fix_perms >/dev/null 2>&1 || true
      ;;
    show-plan|show)
      shift || true
      NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/vault_reorg.py" show-plan "$@"
      ;;
    audit|check-plan)
      shift || true
      if [[ $EUID -eq 0 ]]; then
        NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/vault_reorg.py" audit "$@"
        cmd_fix_perms >/dev/null 2>&1 || true
      else
        # Read-only operator audit: do not require write access to /var/lib/noemaforge/bootstrap.
        # vault_reorg.py will still print the audit to stdout; write it to a temp file if
        # the default report path is not writable by the current user.
        NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/vault_reorg.py" audit --json-out "${TMPDIR:-/tmp}/noemaforge-vault-reorg-audit-${USER:-operator}.json" "$@"
      fi
      ;;
    apply)
      require_root
      shift || true
      NOEMAFORGE_ROOT="$ROOT" /usr/bin/python3 "$ROOT/src/vault_reorg.py" apply "$@"
      cmd_fix_perms >/dev/null 2>&1 || true
      ;;
    -h|--help|help)
      cat <<'EOF'
Usage:
  sudo noemaforge vault scan
  sudo noemaforge vault plan
  noemaforge vault show-plan
  noemaforge vault audit
  sudo noemaforge vault apply --yes
EOF
      ;;
    *) fail "unknown vault action: $action" ;;
  esac
}

