  __safe-start) require_root; require_op noemaforge-op-safe-start.sh; exec "$OP_DIR/noemaforge-op-safe-start.sh" "$@" ;;
  __llm-stop) require_root; require_op noemaforge-op-llm-stop.sh; exec "$OP_DIR/noemaforge-op-llm-stop.sh" "$@" ;;
  __start-llm-safe) require_root; require_op noemaforge-op-start-llm-safe.sh; exec "$OP_DIR/noemaforge-op-start-llm-safe.sh" "$@" ;;
  __safe-mode) require_root; require_op noemaforge-op-safe-mode.sh; exec "$OP_DIR/noemaforge-op-safe-mode.sh" "$@" ;;
  __gui-rescue) require_root; require_op noemaforge-op-gui-rescue.sh; exec "$OP_DIR/noemaforge-op-gui-rescue.sh" "$@" ;;

  -h|--help|help) usage ;;
  *) printf "[noemaforge][ERROR] unknown command: %s\n\n" "$cmd" >&2; usage >&2; exit 2 ;;
esac
