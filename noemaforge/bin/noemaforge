cmd_gui_rescue() {
  case "${1:-}" in
    -h|--help|help|"?")
      require_op noemaforge-op-gui-rescue.sh
      exec "$OP_DIR/noemaforge-op-gui-rescue.sh" --help
      ;;
  esac
  require_root
  local parsed mode args=()
  mapfile -t parsed < <(split_mode_args "$@")
  mode="${parsed[0]}"; args=("${parsed[@]:1}")
  require_op noemaforge-op-gui-rescue.sh
  if is_graphical_session && [[ "$mode" != "direct" ]]; then
    cat <<'EOF'
[noemaforge]
GUI rescue can stop/restart the display manager.
The operation will be moved into a systemd job so it is not killed with the GUI terminal.
EOF
    sleep "${NOEMAFORGE_GUI_RESCUE_COUNTDOWN:-3}"
  fi
  case "$mode" in
    direct) exec "$OP_DIR/noemaforge-op-gui-rescue.sh" "${args[@]}" ;;
    wait) run_transient __gui-rescue noemaforge-gui-rescue "NoemaForge GUI rescue" wait "${args[@]}" ;;
    async) run_transient __gui-rescue noemaforge-gui-rescue "NoemaForge GUI rescue" async "${args[@]}" ;;
  esac
}

