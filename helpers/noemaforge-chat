import argparse,json,os,socket,sys
sock=os.environ.get('NOEMAFORGE_GATEWAY_SOCKET','/run/noemaforge/llm/gateway.sock')
ap=argparse.ArgumentParser(); ap.add_argument('--once',nargs='*'); ap.add_argument('--system',default='You are NoemaForge local assistant. Be concise.'); ap.add_argument('prompt',nargs='*'); ns=ap.parse_args()
prompt=' '.join(ns.once or ns.prompt).strip() or sys.stdin.read().strip()
payload={'model':'main','messages':[{'role':'system','content':ns.system},{'role':'user','content':prompt}],'max_tokens':512,'temperature':0.2}; body=json.dumps(payload,ensure_ascii=False).encode(); req=b'POST /v1/chat/completions HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\nContent-Length: '+str(len(body)).encode()+b'\r\n\r\n'+body
s=socket.socket(socket.AF_UNIX); s.settimeout(120); s.connect(sock); s.sendall(req); out=b''
while True:
    try: c=s.recv(65536)
    except socket.timeout: break
    if not c: break
    out+=c
body=out.split(b'\r\n\r\n',1)[-1]
print(json.loads(body.decode()).get('choices',[{}])[0].get('message',{}).get('content','').strip())
