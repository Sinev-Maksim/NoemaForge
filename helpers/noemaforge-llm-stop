#!/usr/bin/env bash
# === NoemaForge File Header ===
# File: helpers/noemaforge-llm-stop
# Zone: release/package
# Version: 0.32.2
# Created: 2026-05-14
# Modified: 2026-05-25
# Purpose: Compatibility wrapper for display-safe NoemaForge LLM/runtime stop.
# Inputs: CLI flags and canonical noemaforge-stop helper.
# Outputs: Delegated stop report.
# Side effects: Same as helpers/noemaforge-stop.
# Tests: bash -n helpers/noemaforge-llm-stop; sudo helpers/noemaforge-llm-stop --dry-run.
# Notes: Code comments are English-only; user-facing localized text belongs in docs/i18n or locale JSON files.
# === End NoemaForge File Header ===
set -euo pipefail
# Cgroup-aware stop delegation:
# This wrapper delegates to noemaforge-stop which implements the full stop sequence:
#   1. systemctl stop units
#   2. === drain NoemaForge systemd cgroups ===
#      noemaforge_print_unit_cgroups, noemaforge_drain_unit_cgroups TERM,
#      noemaforge_drain_unit_cgroups KILL, cgroup.procs drain via ControlGroup.
#   3. pkill -u noemaforge llama-server processes
# See helpers/noemaforge-stop and lib/noemaforge-common.sh for implementation.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$HERE/noemaforge-stop" "$@"
