# Mount NOEMAFORGE_SHARE read-only after NTFS dirty-state events.
set -euo pipefail
. /usr/local/lib/noemaforge-common.sh
noemaforge_require_root

SRC="$(noemaforge_share_source)"

systemctl stop 'mnt-noemaforge\x2dshare.automount' 'mnt-noemaforge\x2dshare.mount' 2>/dev/null || true
systemctl reset-failed 'mnt-noemaforge\x2dshare.automount' 'mnt-noemaforge\x2dshare.mount' 2>/dev/null || true
umount "$NOEMAFORGE_SHARE_MOUNT" 2>/dev/null || true
install -d -m 0755 "$NOEMAFORGE_SHARE_MOUNT"
mount -t ntfs3 -o "ro,force,uid=${NOEMAFORGE_SHARE_UID},gid=${NOEMAFORGE_SHARE_GID},umask=002,windows_names" "$SRC" "$NOEMAFORGE_SHARE_MOUNT"
findmnt "$NOEMAFORGE_SHARE_MOUNT"
ls -lah "$NOEMAFORGE_SHARE_MOUNT" | sed -n '1,80p'
