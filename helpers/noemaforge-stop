#!/usr/bin/env bash
# === NoemaForge File Header ===
# File: helpers/noemaforge-stop
# Zone: release/package
# Version: 0.32.2
# Created: 2026-05-14
# Modified: 2026-05-25
# Purpose: Stop NoemaForge runtime services without closing the user's graphical desktop by default.
# Inputs: CLI flags, systemd state, canonical VERSION file and NoemaForge runtime directories.
# Outputs: Operator-readable stop report and cleaned NoemaForge runtime sockets where safe.
# Side effects: Stops NoemaForge services/timers and NoemaForge-owned llama-server processes only unless explicit force flags are used.
# Tests: bash -n helpers/noemaforge-stop; sudo helpers/noemaforge-stop --dry-run.
# Notes: Code comments are English-only; user-facing localized text belongs in docs/i18n or locale JSON files.
# === End NoemaForge File Header ===
set -euo pipefail

read_version(){
  local here root
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  for root in "${NOEMAFORGE_ROOT:-}" "/opt/noemaforge" "$here/.."; do
    [[ -n "$root" && -r "$root/VERSION" ]] && { tr -d '[:space:]' < "$root/VERSION"; return 0; }
  done
  printf '0.32.2'
}

VERSION="$(read_version)"
DRY_RUN=0
CLOSE_GUI=0
KILL_ANY_LLAMA=0
RESET_FAILED=1
LOCK_MODE="wait"
LOCK_WAIT_SECONDS=30
LOCK_FILE="/run/noemaforge/noemaforge-stop.lock"
NOEMAFORGE_USER="${NOEMAFORGE_USER:-noemaforge}"
CORE_UNITS=(
  noemaforge-llm-gateway.service
  noemaforge-toolproxy.service
  noemaforge-memsentinel.service
  noemaforge-autostart-gui.timer
  noemaforge-autostart-gui.service
)

usage(){
  cat <<'HELP'
Usage:
  sudo noemaforge-stop [--dry-run]
  sudo noemaforge-stop --close-gui-heavy

Default: stop NoemaForge timers/orchestrators/LLM runtime only.
It does not close Firefox, Nautilus, GDM or the graphical desktop by default.
HELP
}

for arg in "$@"; do
  case "$arg" in
    --dry-run|--plan) DRY_RUN=1 ;;
    --close-gui-heavy|--kill-gui-heavy) CLOSE_GUI=1 ;;
    --kill-any-llama|--force-any-llama) KILL_ANY_LLAMA=1 ;;
    --no-reset-failed) RESET_FAILED=0 ;;
    --skip-if-running) LOCK_MODE="skip" ;;
    --lock-fail|--fail-if-running) LOCK_MODE="fail" ;;
    --lock-wait|--wait-lock|--wait|--direct|--async) : ;;
    -h|--help) usage; exit 0 ;;
    *) printf '[noemaforge-stop][WARN] unknown option ignored: %s\n' "$arg" >&2 ;;
  esac
done

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo '[noemaforge-stop][ERROR] run as root: sudo noemaforge-stop' >&2
  exit 77
fi

mkdir -p /run/noemaforge
exec 9>"$LOCK_FILE" || true
if command -v flock >/dev/null 2>&1; then
  case "$LOCK_MODE" in
    skip) flock -n 9 || { echo '[noemaforge-stop] another stop is running; skip'; exit 0; } ;;
    fail) flock -n 9 || { echo '[noemaforge-stop][ERROR] another stop is running' >&2; exit 66; } ;;
    *) flock -w "$LOCK_WAIT_SECONDS" 9 || { echo '[noemaforge-stop][ERROR] lock wait timeout' >&2; exit 66; } ;;
  esac
fi

printf '=== NoemaForge STOP %s ===\n' "$VERSION"
printf 'dry_run=%s close_gui_heavy=%s kill_any_llama=%s\n' "$DRY_RUN" "$CLOSE_GUI" "$KILL_ANY_LLAMA"
printf 'display_policy=preserve_graphical_desktop_by_default\n'

run_or_print(){
  if [[ "$DRY_RUN" == "1" ]]; then printf '[dry-run] %q ' "$@"; printf '\n'; else "$@"; fi
}

printf '\n=== stop NoemaForge timers/core units ===\n'
if [[ "$DRY_RUN" == "1" ]]; then
  printf '[dry-run] systemctl disable --now noemaforge-autostart-gui.timer noemaforge-autostart-gui.service\n'
  printf '[dry-run] systemctl --no-block stop %s\n' "${CORE_UNITS[*]}"
else
  systemctl disable --now noemaforge-autostart-gui.timer noemaforge-autostart-gui.service 2>/dev/null || true
  systemctl --no-block stop "${CORE_UNITS[@]}" 2>/dev/null || true
fi

printf '\n=== stop NoemaForge llama units ===\n'
mapfile -t LLAMA_UNITS < <(systemctl list-units --all --plain --no-legend 'noemaforge-llama@*.service' 2>/dev/null | awk '{print $1}' | sort -u || true)
if [[ ${#LLAMA_UNITS[@]} -gt 0 ]]; then
  if [[ "$DRY_RUN" == "1" ]]; then printf '[dry-run] systemctl --no-block stop %s\n' "${LLAMA_UNITS[*]}"; else systemctl --no-block stop "${LLAMA_UNITS[@]}" 2>/dev/null || true; fi
else
  echo 'no noemaforge-llama@*.service units found'
fi

printf '\n=== stop NoemaForge-owned llama-server processes ===\n'
if [[ "$DRY_RUN" == "1" ]]; then
  printf '[dry-run] pkill -u %s -TERM/-KILL [l]lama-server\n' "$NOEMAFORGE_USER"
else
  if id "$NOEMAFORGE_USER" >/dev/null 2>&1; then
    pkill -u "$NOEMAFORGE_USER" -TERM -f '[l]lama-server' 2>/dev/null || true
    sleep 2
    pkill -u "$NOEMAFORGE_USER" -KILL -f '[l]lama-server' 2>/dev/null || true
  fi
  if [[ "$KILL_ANY_LLAMA" == "1" ]]; then
    pkill -TERM -f '[l]lama-server' 2>/dev/null || true
    sleep 2
    pkill -KILL -f '[l]lama-server' 2>/dev/null || true
  fi
fi

printf '\n=== remove stale NoemaForge sockets ===\n'
if [[ "$DRY_RUN" == "1" ]]; then
  printf '[dry-run] rm -f /run/noemaforge/llm/gateway.sock /run/noemaforge/llm/backends/*.sock /run/noemaforge/toolproxy.sock\n'
else
  rm -f /run/noemaforge/llm/gateway.sock /run/noemaforge/llm/backends/*.sock /run/noemaforge/toolproxy.sock 2>/dev/null || true
fi

if [[ "$CLOSE_GUI" == "1" ]]; then
  printf '\n=== explicit GUI cleanup requested ===\n'
  printf '[noemaforge-stop][WARN] GUI cleanup is intentionally not implemented in this helper; close user apps manually if needed.\n'
else
  printf '\n=== GUI cleanup skipped ===\n'
  printf 'GDM, Firefox, Nautilus and the desktop session are left untouched.\n'
fi

if [[ "$RESET_FAILED" == "1" && "$DRY_RUN" != "1" ]]; then
  systemctl reset-failed "${CORE_UNITS[@]}" 2>/dev/null || true
  [[ ${#LLAMA_UNITS[@]} -gt 0 ]] && systemctl reset-failed "${LLAMA_UNITS[@]}" 2>/dev/null || true
fi

printf '\n=== failed units ===\n'
systemctl --failed --no-pager 2>/dev/null || true
printf '\n=== active llama processes ===\n'
pgrep -a -f '[l]lama-server' || echo 'no llama-server'
