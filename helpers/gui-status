# NoemaForge legacy-compatible GUI status wrapper.
set -euo pipefail
case "${1:-}" in
  -h|--help|help|"?")
    cat <<'HELP'
Usage: gui-status [--help]

Read-only GUI/NVIDIA/NoemaForge LLM status.
HELP
    exit 0 ;;
esac
if [[ -x /usr/local/sbin/noemaforge ]] && /usr/local/sbin/noemaforge version >/dev/null 2>&1; then
  exec /usr/local/sbin/noemaforge gui-status "$@"
fi
echo "===== display manager ====="
systemctl status display-manager.service gdm.service gdm3.service --no-pager 2>/dev/null | sed -n '1,80p' || true
echo; echo "===== NVIDIA DRM ====="
cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null || echo "nvidia_drm not loaded"
echo; echo "===== GLX ====="
update-alternatives --query glx 2>/dev/null | grep -E '^(Status|Value):' || true
echo; echo "===== NVIDIA-SMI ====="
nvidia-smi 2>&1 | head -35 || true
echo; echo "===== llama-server ====="
pgrep -a -f '[l]lama-server' || echo "no llama-server"
echo; echo "===== failed units ====="
systemctl --failed --no-pager || true
