#!/usr/bin/env bash
# === NoemaForge File Header ===
# File: helpers/noemaforge-smoke
# Zone: release/package
# Version: 0.32.1
# Created: 2026-05-14
# Modified: 2026-05-14
# Purpose: Provide a compatibility helper that delegates to the canonical NoemaForge CLI.
# Inputs: Command-line arguments, environment variables, package files and local NoemaForge runtime state as applicable.
# Outputs: Structured command output, files, service state or UI state as documented by the caller.
# Side effects: Limited to the documented NoemaForge paths, runtime state directories or systemd units used by this file.
# Tests: Syntax validation plus the release setup selftest, consistency-audit and targeted smoke checks.
# Notes: Code comments are English-only; user-facing localized text belongs in docs/i18n or locale JSON files.
# === End NoemaForge File Header ===
set -euo pipefail
. /usr/local/lib/noemaforge-common.sh
DEBUG=0; TIMEOUT=60
for arg in "$@"; do case "$arg" in --debug) DEBUG=1 ;; --timeout=*) TIMEOUT="${arg#*=}" ;; esac; done
backend_sock="${NOEMAFORGE_BACKEND_SOCKET_DIR:-/run/noemaforge/llm/backends}/main.sock"; gateway_sock="${NOEMAFORGE_GATEWAY_SOCKET:-/run/noemaforge/llm/gateway.sock}"
bh=fail; bc=fail; gh=fail; gc=fail; br=''; gr=''; tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
[[ -S "$backend_sock" ]] && runuser -u "$NOEMAFORGE_USER" -- curl -fsS --max-time 15 --unix-socket "$backend_sock" http://localhost:8080/health >/dev/null 2>"$tmp/bh.err" && bh=ok || true
if [[ -S "$backend_sock" ]] && runuser -u "$NOEMAFORGE_USER" -- curl -sS --max-time "$TIMEOUT" --unix-socket "$backend_sock" http://localhost:8080/v1/chat/completions -H 'Content-Type: application/json' -d '{"model":"main","messages":[{"role":"user","content":"Return exactly: OK"}],"max_tokens":8,"temperature":0}' >"$tmp/bc.json" 2>"$tmp/bc.err"; then br=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("choices",[{}])[0].get("message",{}).get("content","").strip())' "$tmp/bc.json" 2>/dev/null || true); [[ "$br" == OK* ]] && bc=ok || bc=non_ok_response; fi
[[ -S "$gateway_sock" ]] && runuser -u "$NOEMAFORGE_USER" -- curl -fsS --max-time 15 --unix-socket "$gateway_sock" http://localhost/health >/dev/null 2>"$tmp/gh.err" && gh=ok || true
if [[ -S "$gateway_sock" ]] && runuser -u "$NOEMAFORGE_USER" -- curl -sS --max-time "$TIMEOUT" --unix-socket "$gateway_sock" http://localhost/v1/chat/completions -H 'Content-Type: application/json' -d '{"model":"main","messages":[{"role":"user","content":"Return exactly: OK"}],"max_tokens":8,"temperature":0}' >"$tmp/gc.json" 2>"$tmp/gc.err"; then gr=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("choices",[{}])[0].get("message",{}).get("content","").strip())' "$tmp/gc.json" 2>/dev/null || true); [[ "$gr" == OK* ]] && gc=ok || gc=non_ok_response; fi
overall=fail; [[ "$bh" == ok && "$bc" == ok && "$gh" == ok && "$gc" == ok ]] && overall=ok
cat <<EOF
=== NoemaForge smoke ===
backend socket: $backend_sock
backend health: $bh
backend chat:   $bc response=$br
gateway socket: $gateway_sock
gateway health: $gh
gateway chat:   $gc response=$gr
overall:        $overall
EOF
if [[ "$DEBUG" == 1 ]]; then echo; echo '=== NoemaForge smoke debug ==='; for f in "$tmp"/*.err; do [[ -s "$f" ]] && echo "$(basename "$f" .err) error: $(cat "$f")"; done; fi
[[ "$overall" == ok ]]
