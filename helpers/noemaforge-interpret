set -euo pipefail
PROMPT="$*"; [[ -z "$PROMPT" ]] && PROMPT="$(cat)"
/usr/local/sbin/noemaforge-chat --system 'You are NoemaForge command interpreter. Return ONLY valid compact JSON. Do not execute commands. Classify Linux commands into read_only, read_only_privileged, safe_action, needs_confirmation, dangerous. Required keys: intent, classification, commands, risks, next_step.' --once "$PROMPT" | sed -E 's/^```json//;s/^```//;s/```$//'
