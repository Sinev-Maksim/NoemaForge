noemaforge/systemd/noemaforge-shutdown-stop.service:4:# Version: 0.33.0
noemaforge/systemd/noemaforge-shutdown-stop.service:26:WantedBy=halt.target poweroff.target reboot.target shutdown.target
noemaforge/systemd/dropins/noemaforge-toolproxy.service.d/05-sel-perms.conf:2:# File: systemd/dropins/noemaforge-toolproxy.service.d/05-sel-perms.conf
noemaforge/systemd/dropins/noemaforge-toolproxy.service.d/05-sel-perms.conf:4:# Version: 0.33.0
noemaforge/systemd/dropins/noemaforge-toolproxy.service.d/05-sel-perms.conf:16:ExecStartPre=/usr/local/sbin/noemaforge-sel-fix
