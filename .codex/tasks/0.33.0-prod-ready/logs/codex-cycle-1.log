+  if [[ -f "$manifest" ]]; then
+    while IFS= read -r rel || [[ -n "$rel" ]]; do
+      rel="${rel%%#*}"
+      rel="${rel#"${rel%%[![:space:]]*}"}"
+      rel="${rel%"${rel##*[![:space:]]}"}"
+      [[ -z "$rel" ]] && continue
