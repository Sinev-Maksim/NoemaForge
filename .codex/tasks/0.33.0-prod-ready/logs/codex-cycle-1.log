+  opt_root="$(target /opt/noemaforge)"
+  manifest="$opt_root/tools/prep/executable_manifest.txt"
+  [[ "$DRY_RUN" == 1 ]] && { echo "normalize /opt/noemaforge owner=root:root dirs=0755 files=0644 manifest_exec=0755"; return 0; }
