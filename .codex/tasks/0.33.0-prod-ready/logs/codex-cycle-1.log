from pathlib import Path
import importlib.util, json, hashlib, datetime
project_root = Path('.').resolve()
spec = importlib.util.spec_from_file_location('mce', project_root / 'noemaforge/src/manifest_checksum_exclusion_runtime.py')
mce = importlib.util.module_from_spec(spec); spec.loader.exec_module(mce)
policy_payload = json.loads((project_root / 'noemaforge/configs/manifest-checksum-exclusion-policy.json').read_text(encoding='utf-8'))
policy = policy_payload['policy']
excluded = mce._as_string_list(policy.get('excluded_dir_names'))
project_only = mce._as_string_list(policy.get('project_only_excluded_dir_names'))
project_excluded = mce._as_string_list(policy.get('project_excluded_file_refs'))
package_root = (project_root / policy.get('package_root_ref', 'noemaforge')).resolve()
now = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace('+00:00','Z')
def sha(path):
    h=hashlib.sha256()
    with path.open('rb') as f:
        for chunk in iter(lambda:f.read(1024*1024), b''): h.update(chunk)
    return h.hexdigest()
def rels(base, files):
    return sorted(mce._normalize_ref(str(p.resolve().relative_to(base.resolve()))) for p in files)
def write_manifest(path, root, files):
    payload=json.loads(path.read_text(encoding='utf-8'))
    rs=rels(root, files)
    payload['generated_at']=now; payload['file_count']=len(rs); payload['files']=rs
    path.write_text(json.dumps(payload, ensure_ascii=False, indent=2)+'\\n', encoding='utf-8')
def write_sums(path, root, files, self_exclusions):
    rows=[]
    for rel in rels(root, files):
        if rel not in self_exclusions:
            rows.append(f'{sha(root/rel)}  {rel}\\n')
    path.write_text(''.join(rows), encoding='utf-8')
project_files=mce._active_files(project_root, excluded, root_only_excluded_dir_names=project_only, excluded_file_refs=project_excluded)
package_files=mce._active_files(package_root, excluded)
write_manifest(project_root/'MANIFEST.json', project_root, project_files)
write_manifest(project_root/'noemaforge/docs/MANIFEST.json', package_root, package_files)
for ref in policy.get('project_manifest_sha_refs', []):
    (project_root/ref).write_text(f\"{sha(project_root/policy['project_manifest_ref'])}  MANIFEST.json\\n\", encoding='utf-8')
for ref in policy.get('package_manifest_sha_refs', []):
    (project_root/ref).write_text(f\"{sha(project_root/policy['package_manifest_ref'])}  MANIFEST.json\\n\", encoding='utf-8')
write_sums(package_root/policy.get('package_checksum_ref','checksums/SHA256SUMS'), package_root, package_files, set(policy.get('package_checksum_self_exclusions', [])))
project_files=mce._active_files(project_root, excluded, root_only_excluded_dir_names=project_only, excluded_file_refs=project_excluded)
write_sums(project_root/'SHA256SUMS', project_root, project_files, set(policy.get('project_checksum_self_exclusions', [])))
print('project_active', len(project_files)); print('package_active', len(package_files))
