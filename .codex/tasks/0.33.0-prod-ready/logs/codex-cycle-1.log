+  find "$opt_root" -type f -exec chmod 0644 {} +
+  find "$opt_root/bin" -maxdepth 1 -type f -exec chmod 0755 {} + 2>/dev/null || true
+  if [[ -f "$manifest" ]]; then
+    while IFS= read -r rel || [[ -n "$rel" ]]; do
