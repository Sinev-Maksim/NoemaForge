+  for unit in noemaforge-llm-gateway.service noemaforge-toolproxy.service; do
+    find "$(target /etc/systemd/system/$unit.d)" -maxdepth 1 -type f -name '*hotfix*' -delete 2>/dev/null || true
+  done
