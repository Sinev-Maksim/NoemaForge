from pathlib import Path
import importlib.util, json, hashlib
project_root = Path('.').resolve()
spec = importlib.util.spec_from_file_location('mce', project_root / 'noemaforge/src/manifest_checksum_exclusion_runtime.py')
mce = importlib.util.module_from_spec(spec); spec.loader.exec_module(mce)
policy = json.loads((project_root / 'noemaforge/configs/manifest-checksum-exclusion-policy.json').read_text(encoding='utf-8'))['policy']
excluded = mce._as_string_list(policy.get('excluded_dir_names'))
project_only = mce._as_string_list(policy.get('project_only_excluded_dir_names'))
project_excluded = mce._as_string_list(policy.get('project_excluded_file_refs'))
files = mce._active_files(project_root, excluded, root_only_excluded_dir_names=project_only, excluded_file_refs=project_excluded)
self_exclusions = set(policy.get('project_checksum_self_exclusions', []))
def norm(p): return mce._normalize_ref(str(p.resolve().relative_to(project_root.resolve())))
def sha(path):
    h=hashlib.sha256()
    with path.open('rb') as f:
        for chunk in iter(lambda:f.read(1024*1024), b''): h.update(chunk)
    return h.hexdigest()
rows=[]
for rel in sorted(norm(p) for p in files):
    if rel not in self_exclusions:
        rows.append(f'{sha(project_root/rel)}  {rel}\\n')
(project_root/'SHA256SUMS').write_text(''.join(rows), encoding='utf-8')
